

		Documentation de la classe 'XcLM_Object'



********************************************************************

int 	XcLM_Allocate_Object(object)
XcLM_Object	**object;

	Alloue l'objet.
	Le pointer 'Send_Zone_List' vaut NULL;
	idem pour 'Data' et 'Descriptor'
	
	erreur = XcLM_MALLOC_ERROR

********************************************************************

int	XcLM_Client_Build_Object(ObjTmp, Client, Name, Attributes, Class, Length, Data)
XcLM_Object			**ObjTmp;
c_LM_Client			*Client;
char				*Name;
XcLM_Object_AttributesMask	Attributes;
XcLM_ClassMask			Class;
XcLM_Object_Length		Length;
char				*Data;

	Construit l'objet a l'adresse 'ObjTmp'
	Remplit les champs de l'objet avec les parametres.
	
	Si 'Client' = NULL, retourne erreur
	
	Si 'Length' = 0, n'alloue pas de memoire pour les donnees.

	erreur = -1 si 'Name' ou 'Owner' non definis
	erreur = XcLM_MALLOC_ERROR
	erreur = XcLM_PERMISSION_DENIED si on tente une operation non
		 implementee (objet manage ...)
	erreur = XcLM_NEED_CLIENT_ERROR si 'Client' vaut NULL
 
********************************************************************

int 	XcLM_Client_Copy_Object(Dest, Source)
XcLM_Object    	**Dest;
XcLM_Object	*Source;

	Copie l'objet 'Source' a l'adresse de l'objet 'Dest'
	Il faut 'Dest' = NULL;

	L'objet copie a les memes proprietes (dynamisme, management, ...)

	erreur = XcLM_MALLOC_ERROR
	erreur = erreurs de "Build_Object"
	erreur = -1 si 'dest' != NULL
	
********************************************************************

int 	XcLM_Client_Destroy_Object(client, object)
c_LM_Client	*client;
XcLM_Object	*object;

	Destruction de l'objet 'object' par le client 'client'

	impossible de se faire passer pour un autre client afin
	d'outrepasser des droits en ecriture car seul le client
	connait son objet : les autres clients n'ont QUE son
	descripteur.

	Si l'objet etait dans la liste publique ou la liste privee,
	alors il se retire automatiquement de la liste.

	Si il n'etait dans une autre liste, il s'en retire ...

********************************************************************

int 	XcLM_Client_Upload_Object(object)
XcLM_Object		*object;


	pas d'implementation pour l'instant ...

********************************************************************

int 	XcLM_Client_Download_Object(object)
XcLM_Object		*object;

	pas d'implementation pour l'instant ...

********************************************************************

int 	XcLM_Client_Allocate_Object_Zone_List(Zone)
XcLM_Object_Zone_List	**Zone;


	Alloue une 'Object_Zone_List'.
	Les champs 'Prev' et 'Next' vallent NULL
	LEs champs 'Start' et 'Length' vallent 0

	erreur : XcLM_MALLOC_ERROR 

********************************************************************

int	XcLM_Client_Unregister_Object(Client_I, Object_I)
c_LM_Client	*Client_I;
XcLM_Object	*Object_I;

	Informe au proprietaire de l'objet que l'on ne veut
	plus le recevoir et efface l'objet du clipboard public.
	Si il y a des liens physiques sur l'objet (cad si il est
	manage) alors un CallBack appelle les differentes instances
	de cet objet pour qu'elles le copient ...

	erreur : XcLM_NO_SUCH_CLIENT si un proprietaire n'existe plus

********************************************************************

int	XcLM_Client_Unregister_Object_List(Client_I, Object_List)
c_LM_Client		*Client_I;
XcLM_Object_List	*Object_List;


	Pour chaque objet de la liste :	

	Informe au proprietaire de l'objet que l'on ne veut
	plus le recevoir et efface l'objet du clipboard public.
	Si il y a des liens physiques sur l'objet (cad si il est
	manage) alors un CallBack appelle les differentes instances
	de cet objet pour qu'elles le copient ...

	erreur : XcLM_NO_SUCH_CLIENT si un proprietaire n'existe plus
		 mais l'erreur n'a pas de caractere definitif :
		 la fonction continue a parcourir la liste des
		 objets apres un echec ...	
	

