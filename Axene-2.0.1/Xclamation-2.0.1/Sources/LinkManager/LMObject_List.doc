


		Documentation sur la classe 'Object List'



******************************************************************

int 	XcLM_Client_Initialize_Object_List(List)
XcLM_Object_List	**List;

	Alloue le ptr et fixe les champs Prev et Next a NULL.

	erreur = XcLM_MALLOC_ERROR

******************************************************************

int    	XcLM_Client_Destroy_Object_List(Client, List)
c_LM_Client			*Client;
XcLM_Object_List		**List;

	Detruit la liste et les objets kelle contient

	
******************************************************************

int    	XcLM_Client_Remove_Object_List(Client, List)
c_LM_Client			*Client;
XcLM_Object_List		**List;

	Detruit la liste mais pas les objets kelle contient.

******************************************************************


int	XcLM_Client_Register_Object(list , object)
XcLM_Object_List	**list;
XcLM_Object		*object;

	Enregistre l'objet a la fin de la liste et alloue pour
	element suivant dans la liste.

	erreur = Xc_MALLOC_ERROR;

******************************************************************

int 	XcLM_Client_Auto_Register_Object(Client, Object2)
c_LM_Client	*Client;
XcLM_Object	*Object2;

	Enregistre l'objet dans le client, a la liste correspondant a sa classe.
	->Public ou Private.

	erreur = -1 si l'objet n'est ni public ni private


******************************************************************

int XcLM_Client_Test_Object_List(List, object_desc)
XcLM_Object_List	*List;
XcLM_Object_Descriptor	*object_desc;


	Teste si le descripteur correspond a un objet de la liste.
	seul le nom est teste.

	erreur = -1 si objet non trouve.

******************************************************************

int XcLM_Client_List_Object(List, class)
XcLM_Object_List	*List;
XcLM_ClassMask		class;

	Affiche la liste des objets de 'List' ayant dans leur 
	masque de class le masque 'class'

	erreur = -1 si 'List' = NULL

******************************************************************

int 	XcLM_Client_Convert_Object_List_To_Object_Descriptor_List(DescList, ObjList)
XcLM_Object_Descriptor_List	**DescList;
XcLM_Object_List		*ObjList;

	Convertit une liste d'objets 'ObjList' en une liste de
	descripteurs 'DescList' a la position definie par 'DescList'.

	Si 'DescList' = NULL, DescList est alloue.

	Pour liberer toute la memoire, il faut utiliser
	la fonction 'XcLM_Client_Destroy_Object_Descriptor_List'
	En effet, les descripteurs sont COPIES d'une liste a l'autre.

	erreur = -1 si ObjList = NULL
	erreur = XcLM_MALLOC_ERROR
******************************************************************
******************************************************************





