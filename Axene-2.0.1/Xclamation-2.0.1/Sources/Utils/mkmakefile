#!/bin/sh
#
# mkmakefile for Xclamation, XQuad, XAllWrite, XMayday, XInstall and 
# 	AxeneOffice in Utils/
# Script to automatically generate a working Makefile
# on various exotic OS (sco odt, unixware...)
#
