# PLEASE DO NOT EDIT THIS FILE, it is generated by Utils/mkmakefile
# Edit Makefile.in then do a "make makefile"

# Rules list:
# all:			Compile main 
# link:			Just link main
# notrace:		Compile main with -DEFINITIVE_VERSION
# editres:		Compile main with -DEDITRES_COMPATIBLE
# pixmaps:		Compress xpm in zpm format
# complete:		Make all complete
# sure:			Clean sources then make complete
# realname:		Copy main to real Package name
# profile:		Make main with profile information
# profile_notrace:	Make main with profile info w/out traces
# buildenv:		Run ad, rc, builtdate and headers rules
# ad:			Make AD files (Application Defaults)
# headers:		Link all header files in Headers/
# showenv:		Show compilation Environment variables
# clean:		Clean Main/ directory
# zclean:		Clean all
# depend:		Generate dependencies
# makefile:		Generate Makefile

# --------------------------------------------------------------------- 
# Program name variable
PROG_NAME	= main
REAL_PROG_NAME	= AxeneOffice
SHELL		= /bin/sh

# --------------------------------------------------------------------- 
# Systems libraries variable
LIBS=	$(MOTIF_LIBS) $(X11_LIBS) $(SOCK_LIBS) -lm

# --------------------------------------------------------------------- 
# compil' objects variable
OBJ = \
 Main/main.o \
 MainInterface/MainInterface.o \
 MainInterface/Actions.o \
 Interface/Interface.o \
 Xpm/Xpm.o \
 Xpm/fsdither.o \
 Resource/Resource.o \
 Colormap/Colormap.o \
 DocIcon/DocIcon.o \
 Cursor/Cursor.o \
 Icon/Icon.o \
 Label/Label.o \
 RowColumn/RowColumn.o \
 PopupMenu/PopupMenu.o \
 XErrorHandler/XErrorHandler.o \
 SignalHandler/SignalHandler.o \
 HelpLine/HelpLine.o \
 ManageWidget/ManageWidget.o \
 CustomDialog/CustomDialog.o \
 CustomDialog/AlertBox.o \
 ImageManager/ImageManager.o \
 LaunchCmd/LaunchCmd.o \
 LaunchCmd/RH_xclamation.o \
 LaunchCmd/RH_xquad.o \
 LaunchCmd/RH_xallwrite.o \
 LaunchCmd/RH_xmayday.o \
 LaunchCmd/ClientWin.o \
 Global/misc.o \
 Global/readkey.o \
 Global/fileutils.o \
 Global/filename.o \
 Global/fnmatch.o \
 Main/check.o

SRC = $(OBJ:.o=.c)

# --------------------------------------------------------------------- 
# Program libraries variable
XcLIBS=	lib/Managers.a

# --------------------------------------------------------------------- 
# Uptodate files
UPTODATE= Pixmaps/uptodate AD/uptodate

# ---------------------------------------------------------------------
# Compilation rules

all:	showenv $(PROG_NAME)		

# ---------------------------------------------------------------------
$(PROG_NAME):	$(UPTODATE) $(OBJ) $(XcLIBS)
	@echo Linking $(REAL_PROG_NAME)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
objs:	$(OBJ) $(XcLIBS)

# ---------------------------------------------------------------------
link:
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(OBJ) \
		$(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; export CPPFLAGS; \
	$(MAKE)

# ---------------------------------------------------------------------
editres:
	CPPFLAGS="$(CPPFLAGS) -DEDITRES_COMPATIBLE"; \
	X11_LIBS="$(X11_LIBS) -lXmu"; export CPPFLAGS X11_LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
get_realname: Utils/get_realname.o
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) Utils/get_realname.o -o $@
	@echo "done."

# ---------------------------------------------------------------------
pixmaps:
	@cd Pixmaps; $(MAKE) clean ; $(MAKE); $(MAKE) test

# ---------------------------------------------------------------------
complete:
	@$(MAKE) ad
	@$(MAKE) builtdate
	@$(MAKE) notrace
	@$(MAKE) realname

# ---------------------------------------------------------------------
sure:
	@echo --------------------- MAKING ALL PERFECT -----------------------
	@$(MAKE) zclean
	@$(MAKE) headers
	@$(MAKE) complete
	@echo End time: `date`

realname:	get_realname
	@Utils/echonl.sh "Strip & Copy $(PROG_NAME) to "`get_realname`" "
	@strip $(PROG_NAME)
	@cp $(PROG_NAME) `get_realname`
	@echo "done."

# ---------------------------------------------------------------------
# Profile rules

profile:
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CFLAGS LDFLAGS LIBS; \
	$(MAKE)

profile_notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; \
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CPPFLAGS CFLAGS LDFLAGS LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
# Special compilation command

lib/Managers.a:
	@cd Managers; $(MAKE)

Pixmaps/uptodate:
	cd Pixmaps; $(MAKE)

AD/uptodate:
	@Utils/do_ad

Main/check.o:	Main/check.c
	@Utils/echonl.sh "Compile: "$@" using X11CONFIG='$(X11CONFIG)' "
	@$(CC) $(CPPFLAGS) $(CFLAGS) $(X11CONFIG) -IHeaders -c $< -o $@	   
	@echo "done."

.c.o:
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."

# ---------------------------------------------------------------------
# Generate config files

ad:
	@Utils/do_ad

rc:	


headers:
	@if [ -x /bin/tcsh ]; then Utils/do_header; else Utils/do_header2; fi

BUILTDATE=	Main/builtdate.h
builtdate:
	@echo Building date:  `/bin/date` ;\
	echo "#define MAKE_DATE_DATE" \"`/bin/date`\" > $(BUILTDATE) ; \
	echo "#define MAKE_DATE_YEAR" \"`/bin/date +%y`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_MONTH" \"`/bin/date +%m`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_DAY" \"`/bin/date +%d`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_TIME" \"`/bin/date +%X`\" >> $(BUILTDATE); \
	[ -n "$SYSTEM_NAME" ] && \
	echo "#define MAKE_SYSTEM" \"$(SYSTEM_NAME)\" >> $(BUILTDATE); \
	[ -n "$PACKAGE_NAME" ] && \
	echo "#define MAKE_PACKAGE" \"$(PACKAGE_NAME)\" >> $(BUILTDATE);

check:
	nm $(OBJ) > /dev/null

buildenv:
	@$(MAKE) ad
	@$(MAKE) rc
	@$(MAKE) builtdate
	@$(MAKE) headers

showenv:
	@echo ---------------- Compilation options ---------------------------------------
	@echo "CFLAGS=\"$(CFLAGS)\""
	@echo "CPPFLAGS=\"$(CPPFLAGS)\""
	@echo "LDFLAGS=\"$(LDFLAGS)\""
	@echo "MOTIF_LIBS=\"$(MOTIF_LIBS)\""
	@echo "X11_LIBS=\"$(X11_LIBS)\""
	@echo "export CFLAGS CPPFLAGS LDFLAGS MOTIF_LIBS X11_LIBS"
	@echo ----------------------------------------------------------------------------

# ---------------------------------------------------------------------
# Clean rules

clean:
	@echo "Cleaning ROOT DIRECTORY"
	@rm -f *.o *~ \#* *.bak core $(PROG_NAME) $(REAL_PROG_NAME)* \
		get_realname

zclean:	clean clean_lib clean_pixmaps clean_ad
	@echo "Cleaning *.o"
	@rm -f $(OBJ) $(PROG_NAME) Utils/*.o

clean_lib:
	@Utils/echonl.sh "Cleaning LIBS: "
	@Utils/echonl.sh "Managers"; cd Managers; $(MAKE) clean > /dev/null
	@echo "."

clean_pixmaps:
	@echo "Cleaning PIXMAPS"
	@cd Pixmaps; $(MAKE) clean > /dev/null

clean_ad:
	@Utils/do_ad clean

# ---------------------------------------------------------------------
# Make depend rule

depend:	
	cp Makefile Makefile-depend
	gcc -MM -IHeaders $(SRCS) >> Makefile-depend

# ---------------------------------------------------------------------
# Make Makefile

makefile:
	@Utils/mkmakefile

all_makefiles:
	@Utils/mkmakefile all

cross_makefile:
	@Utils/mkmakefile interactive

# ---------------------------------------------------------------------
# Installationd rule

install:	get_realname
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	LANGUAGE=$${LANGUAGE:-English.us}; \
	REALNAME=`get_realname`; \
	echo "Installing $(REAL_PROG_NAME) in $$PREFIX"; \
	Utils/install.sh $(REAL_PROG_NAME) $$REALNAME $$PREFIX; \
	echo "Customize for $$LANGUAGE language."; \
	Utils/postinstall.sh $$PREFIX $$LANGUAGE

# ---------------------------------------------------------------------
# Dependencies rules

MainInterface/MainInterface.o:	Global/AxeneOffice.ad.h \
	Headers/version.h
Resource/Resource.o:	Headers/Resource_OFFICE.h Headers/version.h
