SHELL= /bin/sh
SUBDIRS =

CC =
CFLAGS =
CPPFLAGS =
LDFLAGS =
SOCK_LIBS =
MOTIF_LIBS =
X11_LIBS =
X11CONFIG =
ARFLAGS =

SYSTEM_NAME = 
PACKAGE_NAME =

PREFIX =
LANGUAGE =

all:	$(SUBDIRS)
	@echo ""; echo "Ok, everything is built now. Next, run 'make install'."

install:	$(DEPFILES)
	@PREFIX="$(PREFIX)"; LANGUAGE="$(LANGUAGE)"; export PREFIX LANGUAGE; \
	for i in $(SUBDIRS); do \
	echo ""; echo ""; echo Install all in $$i; echo ""; echo "" ; \
	cd $$i; $(MAKE) install; cd ..; done

clean:	
	@for i in $(SUBDIRS); do \
	echo ""; echo ""; echo Clean all in $$i; echo ""; echo "" ; \
	cd $$i; $(MAKE) zclean; rm -f buildenv; cd ..; done

# BEGIN SUBST
<<SUBST>>:	<<SUBST>>/buildenv <<SUBST>>/main
	@echo "Ok, everything is built in <<SUBST>>"

<<SUBST>>/buildenv:
	@echo ""; echo ""; echo Build env. in <<SUBST>>; echo ""; echo "" 
	@cd <<SUBST>>; SYSTEM_NAME="$(SYSTEM_NAME)"; \
	PACKAGE_NAME="$(PACKAGE_NAME)"; export SYSTEM_NAME PACKAGE_NAME; \
	$(MAKE) buildenv
	touch <<SUBST>>/buildenv

<<SUBST>>/main:
	@echo ""; echo ""; echo Compile all in <<SUBST>>; echo ""; echo "" 
	@cd <<SUBST>>; CC="$(CC)"; CFLAGS="$(CFLAGS)"; \
	CPPFLAGS="$(CPPFLAGS)"; \
	LDFLAGS="$(LDFLAGS)"; SOCK_LIBS="$(SOCK_LIBS)"; \
	MOTIF_LIBS="$(MOTIF_LIBS)"; X11_LIBS="$(X11_LIBS)"; \
	X11CONFIG="$(X11CONFIG)"; ARFLAGS="$(ARFLAGS)"; \
	export CC CFLAGS CPPFLAGS LDFLAGS; \
	export SOCK_LIBS MOTIF_LIBS X11_LIBS X11CONFIG ARFLAGS; \
	$(MAKE) notrace; \
	$(MAKE) realname

# END SUBST
# End of global Makefile
