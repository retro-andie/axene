
\FORMATLIST{
	\FORMAT0{\NAME{Standard} \COMMA44 \TRUNCATE_ENABLE \NORMAL_TYPE
		\STANDARD}
	\FORMAT1{\NAME{Nombre [0d]} \MAX_PREC0 \COMMA44 \NORMAL_TYPE}
	\FORMAT2{\NAME{Nombre [2d]} \MAX_PREC2 \COMMA44 \NORMAL_TYPE}
	\FORMAT3{\NAME{Milliers [0d]} \MAX_PREC0 \SPACE3 \COMMA44 \NORMAL_TYPE}
	\FORMAT4{\NAME{Milliers [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3\ COMMA44 
		\NORMAL_TYPE \THOUSANDS}
	\FORMAT5{\NAME{Milliers [0d, nég rouge]} \MAX_PREC0 \SPACE3 \COMMA44 
		\COLORNEG200 \NORMAL_TYPE}
	\FORMAT6{\NAME{Milliers [2d, nég rouge]} \MIN_PREC2 \MAX_PREC2 \SPACE3 
		\COMMA44 \COLORNEG200 \NORMAL_TYPE}
	\FORMAT7{\NAME{Monétaire [0d]} \MAX_PREC0 \SPACE3 \UNIT{ F} \UNITAFTER 
		\COMMA44 \UNIT_TYPE}
	\FORMAT8{\NAME{Monétaire [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3 \UNIT{ F} 
		\UNITAFTER \COMMA44 \UNIT_TYPE}
	\FORMAT9{\NAME{Monétaire [0d, nég rouge]} \MAX_PREC0 \SPACE3 \UNIT{ F} 
		 \UNITAFTER \COMMA44 \COLORNEG200 \UNIT_TYPE}
	\FORMAT10{\NAME{Monétaire [2d, nég rouge]} \MIN_PREC2 \MAX_PREC2 
		\SPACE3 \UNIT{ F} \UNITAFTER \COMMA44 \COLORNEG200 \UNIT_TYPE 
		\CURRENCY}
	\FORMA11{\NAME{US-Monétaire [0d]} \MAX_PREC0 \SPACE3 \UNIT{ $} 
		\UNITAFTER \COMMA44 \UNIT_TYPE}
	\FORMAT12{\NAME{US-Monétaire [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3 
		\UNIT{ $} \UNITAFTER \COMMA44 \UNIT_TYPE}
	\FORMAT14{\NAME{US-Monétaire [0d, nég rouge]} \MAX_PREC0 \SPACE3 
		\UNIT{ $} \UNITAFTER \COMMA44 \COLORNEG200 \UNIT_TYPE}
	\FORMAT15{\NAME{US-Monétaire [2d, nég rouge]} \MIN_PREC2 \MAX_PREC2 
		\SPACE3 \UNIT{ $} \UNITAFTER \COMMA44 \COLORNEG200 
		\UNIT_TYPE \CURRENCY}
	\FORMAT16{\NAME{Pourcentage [0d]} \MAX_PREC0 \UNIT{ %} \UNITAFTER 
		\COMMA44 \PERCENT_TYPE}
	\FORMAT17{\NAME{Pourcentage [2d]} \MIN_PREC2 \MAX_PREC2 \UNIT{ %} 
		\UNITAFTER \COMMA44 \PERCENT_TYPE \PERCENT}
	\FORMAT18{\NAME{Pourcentage [0d, nég rouge]} \MAX_PREC0 \UNIT{ %} 
		\UNITAFTER \COMMA44 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT19{\NAME{Pourcentage [2d, nég rouge]} \MIN_PREC2 \MAX_PREC2 
		\UNIT{ %} \UNITAFTER \COMMA44 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT20{\NAME{Jour de la semaine [très court]} \DAY_NAME_VERY_SHORT 
		\DAY_TYPE}
	\FORMAT21{\NAME{Jour de la semaine [court]} \DAY_NAME_SHORT \DAY_TYPE}
	\FORMAT22{\NAME{Jour de la semaine [long]} \DAY_NAME_LONG \DAY_TYPE}
	\FORMAT23{\NAME{Mois de l'année [très court]} \MONTH_NAME_VERY_SHORT 
		\MONTH_TYPE}
	\FORMAT24{\NAME{Mois de l'année [court]} \MONTH_NAME_SHORT \MONTH_TYPE}
	\FORMAT25{\NAME{Mois de l'année [long]} \MONTH_NAME_LONG \MONTH_TYPE}
	\FORMAT26{\NAME{Booléen} \BOOLEAN_TYPE}
	\FORMAT27{\NAME{Booléen [faux rouge]} \FALSE_COLOR200 \BOOLEAN_TYPE}
	\FORMAT28{\NAME{Booléen [perso]} \TRUE_NAME{Exact} 
		\FALSE_NAME{Mauvais} \BOOLEAN_TYPE}
	\FORMAT29{\NAME{Booléen [perso, faux rouge]} \FALSE_COLOR200 
		\TRUE_NAME{Exact} \FALSE_NAME{Mauvais} \BOOLEAN_TYPE}
	\FORMAT30{\NAME{Date [DD/MM/YY]} \DATE_SEQUENCE{\PADDING_ZERO \DAY 
		\STRING{/} \MONTH \STRING{/} \YEAR_SHORT} \DATE_TYPE}
	\FORMAT31{\NAME{Date [DD mm YYYY]} \DATE_SEQUENCE{\PADDING_SPACE \DAY 
		\STRING{\x20} \MONTH_NAME_LONG \STRING{\x20} \YEAR} \DATE_TYPE}
	\FORMAT32{\NAME{Date [dd mmmm YYYY]} \DATE_SEQUENCE{ \DAY_NAME_SHORT 
		\STRING{\x20} \PADDING_NONE \DAY \STRING{\x20} 
		\MONTH_NAME_LONG \STRING{\x20} \YEAR_JC_REF} \DATE_TYPE}
	\FORMAT33{\NAME{Heure [HH:MM:SS.sss]} \TIME_SEQUENCE{ \PADDING_ZERO 
		\HOUR \STRING{:} \MINUTE \STRING{:} \SECOND \STRING{.} 
		\THOUSANDTH_OF_SECOND} \TIME_TYPE}
	\FORMAT34{\NAME{Heure [HH:MM:SS [AP]M]} \TIME_SEQUENCE{ \PADDING_SPACE
		 \HOUR12 \STRING{:} \PADDING_ZERO \MINUTE \STRING{:} 
		\SECOND \STRING{\x20} \HOUR_AM_PM} \TIME_TYPE}
	\FORMAT35{\NAME{Date et Heure [DD/MM/YYYY HH:MM:SS]} 
		\DATE_AND_TIME_SEQUENCE{\PADDING_ZERO \DAY \STRING{/} \MONTH 
		\STRING{/} \YEAR \STRING{\x20} \HOUR \STRING{:} \MINUTE 
		\STRING{:} \SECOND} \DATE_AND_TIME_TYPE}
	\FORMAT36{\NAME{Fraction [??/??]} \FRAC_PREC2 \FRACTION_TYPE}
	\FORMAT37{\NAME{Fraction [???/???]} \FRAC_PREC3 \FRACTION_TYPE}
	\FORMAT38{\NAME{Fraction décimal [??/??]} \FRAC_PREC2 \FRAC_DECIMAL 
		\FRACTION_TYPE}
	\FORMAT39{\NAME{Fraction décimal [???/???]} \FRAC_PREC3 \FRAC_DECIMAL 
		\FRACTION_TYPE}
	\FORMAT40{\NAME{Exp: [0,00E+00]} \COMMA44 \MIN_PREC2 \MAX_PREC2 
		\EXP_DIGIT2 \EXP_MULTIPLE1 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT41{\NAME{Exp: [##0,0E+0]} \COMMA44 \MIN_PREC1 \MAX_PREC1 
		\EXP_DIGIT1 \EXP_MULTIPLE3 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT42{\NAME{Exp: scientifique} \COMMA44 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE1 \EXP_STRING{E} \EXPONANTIAL_TYPE \SCIENTIFIC}
	\FORMAT43{\NAME{Exp: ingénieur} \COMMA44 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE3 \EXP_STRING{E} \EXPONANTIAL_TYPE \ENGINEER}
	\FORMAT44{\NAME{Generic} \COMMA44 \TRUNCATE_ENABLE \DAY_NAME_LONG
		\MONTH_NAME_LONG \DATE_SEQUENCE{\DAY \STRING{/}
		\PADDING_ZERO \MONTH \STRING{/} \YEAR_SHORT}
		\TIME_SEQUENCE{ \HOUR \PADDING_ZERO \STRING{:} \MINUTE }
		\DATE_AND_TIME_SEQUENCE{ \DAY \STRING{/} \PADDING_ZERO \MONTH
		\STRING{/} \YEAR \STRING{\x20} \PADDING_SPACE \HOUR 
		\PADDING_ZERO \STRING{:} \MINUTE} \FRAC_PREC3 \FRAC_DECIMAL
		\EXP_DIGIT2 \EXP_MULTIPLE1 \EXP_SIGN \EXP_STRING{E} \GENERIC}
}		
