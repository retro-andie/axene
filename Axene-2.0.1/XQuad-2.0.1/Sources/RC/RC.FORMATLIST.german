
\FORMATLIST{
	\FORMAT0{\NAME{Standard} \COMMA44 \TRUNCATE_ENABLE \NORMAL_TYPE
		\STANDARD}
	\FORMAT1{\NAME{Zahlen [0d]} \MAX_PREC0 \COMMA44 \NORMAL_TYPE}
	\FORMAT2{\NAME{Zahlen [2d]} \MAX_PREC2 \COMMA44 \NORMAL_TYPE}
	\FORMAT3{\NAME{Tausender [0d]} \MAX_PREC0 \SPACE3 \COMMA44
		\NORMAL_TYPE}
	\FORMAT4{\NAME{Tausender [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3\ COMMA44 
		\NORMAL_TYPE \THOUSANDS}
	\FORMAT5{\NAME{Tausender [0d, rot neg]} \MAX_PREC0 \SPACE3 \COMMA44 
		\COLORNEG200 \NORMAL_TYPE}
	\FORMAT6{\NAME{Tausender [2d, rot neg]} \MIN_PREC2 \MAX_PREC2 \SPACE3 
		\COMMA44 \COLORNEG200 \NORMAL_TYPE}
	\FORMAT7{\NAME{Währung [0d]} \MAX_PREC0 \SPACE3 \UNIT{DM }
		\COMMA44 \UNIT_TYPE}
	\FORMAT8{\NAME{Währung [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3 \UNIT{DM } 
		\COMMA44 \UNIT_TYPE}
	\FORMAT9{\NAME{Währung [0d, rot neg]} \MAX_PREC0 \SPACE3 \UNIT{DM } 
		 \COMMA44 \COLORNEG200 \UNIT_TYPE}
	\FORMAT10{\NAME{Währung [2d, rot neg]} \MIN_PREC2 \MAX_PREC2 
		\SPACE3 \UNIT{DM } \COMMA44 \COLORNEG200 \UNIT_TYPE \CURRENCY}
	\FORMA11{\NAME{US-Währung [0d]} \MAX_PREC0 \SPACE3 \UNIT{$ } 
		\COMMA44 \UNIT_TYPE}
	\FORMAT12{\NAME{US-Währung [2d]} \MIN_PREC2 \MAX_PREC2 \SPACE3 
		\UNIT{$ } \COMMA44 \UNIT_TYPE}
	\FORMAT14{\NAME{US-Währung [0d, rot neg]} \MAX_PREC0 \SPACE3 
		\UNIT{$ } \COMMA44 \COLORNEG200 \UNIT_TYPE}
	\FORMAT15{\NAME{US-Währung [2d, rot neg]} \MIN_PREC2 \MAX_PREC2 
		\SPACE3 \UNIT{$ } \COMMA44 \COLORNEG200 
		\UNIT_TYPE \CURRENCY}
	\FORMAT16{\NAME{Prozent [0d]} \MAX_PREC0 \UNIT{ %} \UNITAFTER 
		\COMMA44 \PERCENT_TYPE}
	\FORMAT17{\NAME{Prozent [2d]} \MIN_PREC2 \MAX_PREC2 \UNIT{ %} 
		\UNITAFTER \COMMA44 \PERCENT_TYPE \PERCENT}
	\FORMAT18{\NAME{Prozent [0d, rot neg]} \MAX_PREC0 \UNIT{ %} 
		\UNITAFTER \COMMA44 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT19{\NAME{Prozent [2d, rot neg]} \MIN_PREC2 \MAX_PREC2 
		\UNIT{ %} \UNITAFTER \COMMA44 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT20{\NAME{Wochentage [sehr kurz]} \DAY_NAME_VERY_SHORT 
		\DAY_TYPE}
	\FORMAT21{\NAME{Wochentage [kurz]} \DAY_NAME_SHORT \DAY_TYPE}
	\FORMAT22{\NAME{Wochentage [lang]} \DAY_NAME_LONG \DAY_TYPE}
	\FORMAT23{\NAME{Monat [sehr kurz]} \MONTH_NAME_VERY_SHORT 
		\MONTH_TYPE}
	\FORMAT24{\NAME{Monat [kurz]} \MONTH_NAME_SHORT \MONTH_TYPE}
	\FORMAT25{\NAME{Monat [lang]} \MONTH_NAME_LONG \MONTH_TYPE}
	\FORMAT26{\NAME{Boolean} \BOOLEAN_TYPE}
	\FORMAT27{\NAME{Boolean [falsch rot]} \FALSE_COLOR200 \BOOLEAN_TYPE}
	\FORMAT28{\NAME{Boolean [custom]} \TRUE_NAME{Good} 
		\FALSE_NAME{Bas} \BOOLEAN_TYPE}
	\FORMAT29{\NAME{Boolean [custom, falsch rot]} \FALSE_COLOR200 
		\TRUE_NAME{Good} \FALSE_NAME{Bad} \BOOLEAN_TYPE}
	\FORMAT30{\NAME{Datum [DD/MM/YY]} \DATE_SEQUENCE{\PADDING_ZERO \DAY 
		\STRING{/} \MONTH \STRING{/} \YEAR_SHORT} \DATE_TYPE}
	\FORMAT31{\NAME{Datum [DD mm YYYY]} \DATE_SEQUENCE{\PADDING_SPACE \DAY 
		\STRING{\x20} \MONTH_NAME_LONG \STRING{\x20} \YEAR} \DATE_TYPE}
	\FORMAT32{\NAME{Datum [dd mmmm YYYY]} \DATE_SEQUENCE{ \DAY_NAME_SHORT 
		\STRING{\x20} \PADDING_NONE \DAY \STRING{\x20} 
		\MONTH_NAME_LONG \STRING{\x20} \YEAR_JC_REF} \DATE_TYPE}
	\FORMAT33{\NAME{Zeit [HH:MM:SS.sss]} \TIME_SEQUENCE{ \PADDING_ZERO 
		\HOUR \STRING{:} \MINUTE \STRING{:} \SECOND \STRING{.} 
		\THOUSANDTH_OF_SECOND} \TIME_TYPE}
	\FORMAT34{\NAME{Zeit [HH:MM:SS [AP]M]} \TIME_SEQUENCE{ \PADDING_SPACE
		 \HOUR12 \STRING{:} \PADDING_ZERO \MINUTE \STRING{:} 
		\SECOND \STRING{\x20} \HOUR_AM_PM} \TIME_TYPE}
	\FORMAT35{\NAME{Datum & Zeit [DD/MM/YYYY HH:MM:SS]} 
		\DATE_AND_TIME_SEQUENCE{\PADDING_ZERO \DAY \STRING{/} \MONTH 
		\STRING{/} \YEAR \STRING{\x20} \HOUR \STRING{:} \MINUTE 
		\STRING{:} \SECOND} \DATE_AND_TIME_TYPE}
	\FORMAT36{\NAME{Bruch [??/??]} \FRAC_PREC2 \FRACTION_TYPE}
	\FORMAT37{\NAME{Bruch [???/???]} \FRAC_PREC3 \FRACTION_TYPE}
	\FORMAT38{\NAME{Nachkommazahlen als Bruch [??/??]} \FRAC_PREC2
		\FRAC_DECIMAL \FRACTION_TYPE}
	\FORMAT39{\NAME{Nachkommazahlen als Bruch [???/???]} \FRAC_PREC3
		\FRAC_DECIMAL \FRACTION_TYPE}
	\FORMAT40{\NAME{Exp: [0,00E+00]} \COMMA44 \MIN_PREC2 \MAX_PREC2 
		\EXP_DIGIT2 \EXP_MULTIPLE1 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT41{\NAME{Exp: [##0,0E+0]} \COMMA44 \MIN_PREC1 \MAX_PREC1 
		\EXP_DIGIT1 \EXP_MULTIPLE3 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT42{\NAME{Exp: wissenschaftlich} \COMMA44 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE1 \EXP_STRING{E} \EXPONANTIAL_TYPE \SCIENTIFIC}
	\FORMAT43{\NAME{Exp: technisch} \COMMA44 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE3 \EXP_STRING{E} \EXPONANTIAL_TYPE \ENGINEER}
	\FORMAT44{\NAME{Generic} \COMMA44 \TRUNCATE_ENABLE \DAY_NAME_LONG
		\MONTH_NAME_LONG \DATE_SEQUENCE{\DAY \STRING{/}
		\PADDING_ZERO \MONTH \STRING{/} \YEAR_SHORT}
		\TIME_SEQUENCE{ \HOUR \PADDING_ZERO \STRING{:} \MINUTE }
		\DATE_AND_TIME_SEQUENCE{ \DAY \STRING{/} \PADDING_ZERO \MONTH
		\STRING{/} \YEAR \STRING{\x20} \PADDING_SPACE \HOUR 
		\PADDING_ZERO \STRING{:} \MINUTE} \FRAC_PREC3 \FRAC_DECIMAL
		\EXP_DIGIT2 \EXP_MULTIPLE1 \EXP_SIGN \EXP_STRING{E} \GENERIC}
}		
