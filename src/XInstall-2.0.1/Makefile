# PLEASE DO NOT EDIT THIS FILE, it is generated by ../Utils/mkmakefile
# Edit Makefile.in then do a "make makefile"

# Rules list:
# all:			Compile main 
# link:			Just link main
# notrace:		Compile main with -DEFINITIVE_VERSION
# editres:		Compile main with -DEDITRES_COMPATIBLE
# pixmaps:		Compress xpm in zpm format
# complete:		Make all complete
# sure:			Clean sources then make complete
# realname:		Copy main to real Package name
# profile:		Make main with profile information
# profile_notrace:	Make main with profile info w/out traces
# buildenv:		Run ad, rc, builtdate and headers rules
# ad:			Make AD files (Application Defaults)
# headers:		Link all header files in Headers/
# showenv:		Show compilation Environment variables
# clean:		Clean Main/ directory
# zclean:		Clean all
# depend:		Generate dependencies
# makefile:		Generate Makefile

# --------------------------------------------------------------------- 
# Program name variable
PROG_NAME	= main
REAL_PROG_NAME	= XInstall
SHELL		= /bin/sh

# ---------------------------------------------------------------------
# POSIX.1-1997 / ANSI C89 portability flags
# Set POSIX_FLAGS per platform (see XAllWrite-2.0.1/Makefile.in for table).
POSIX_FLAGS = -D_POSIX_C_SOURCE=199506L

# ---------------------------------------------------------------------
# Systems libraries variable
LIBS=	$(MOTIF_LIBS) $(X11_LIBS) $(SOCK_LIBS) -lm

# --------------------------------------------------------------------- 
# compil' objects variable
OBJ= 	Main/main.o \
 MainInterface/MainInterface.o \
 MainInterface/Actions.o \
 CustomDialog/CustomDialog.o \
 CustomDialog/AlertBox.o \
 DocIcon/DocIcon.o \
 Grid/Grid.o \
 Label/Label.o \
 XLabel/XLabel.o \
 ToggleButton/ToggleButton.o \
 ScrolledWindow/ScrolledWindow.o \
 Frame/Frame.o \
 Form/Form.o \
 Icon/Icon.o \
 ProgressBar/ProgressBar.o \
 ManageWidget/ManageWidget.o \
 Xpm/Xpm.o \
 Xpm/fsdither.o \
 Resource/Resource.o \
 Tongues/Tongues.o \
 XErrorHandler/XErrorHandler.o \
 SignalHandler/SignalHandler.o \
 Colormap/Colormap.o \
 Cursor/Cursor.o \
 ImageManager/ImageManager.o \
 WTextField/WTextField.o \
 DirSelector/DirSelector.o \
 DirSelector/BrowseDirectorySrc.o \
 DirSelector/BrowseDirectoryDst.o \
 ItemList/ItemList.o \
 ItemMenu/ItemMenu.o \
 Box_language/Box_language.o \
 Box_directory/Box_directory.o \
 Box_select/Box_select.o \
 Box_key/Box_key.o \
 Box_install/Box_install.o \
 Box_license/Box_license.o \
 Box_keygen/Box_keygen.o \
 Images/Image.o \
 Images/gif.o \
 Dither/Dither.o \
 Encrypt/Encrypt.o \
 GenEndKey/GenEndKey.o \
 TestCDKey/TestCDKey.o \
 TestCDKey/TestIDFile.o \
 Tar/Tar.o \
 Global/readkey.o \
 Global/filename.o \
 Global/fileutils.o \
 Global/fnmatch.o \
 Global/misc.o

SRC = $(OBJ:.o=.c)

# --------------------------------------------------------------------- 
# Program libraries variable
XcLIBS=	lib/Managers.a lib/gzip.a lib/Ufc.a

# --------------------------------------------------------------------- 
# Uptodate files
UPTODATE= Pixmaps/uptodate

# ---------------------------------------------------------------------
# Compilation rules

all:	showenv $(PROG_NAME)

# ---------------------------------------------------------------------
$(PROG_NAME):	$(UPTODATE) $(OBJ) $(XcLIBS) 
	@echo Linking $(REAL_PROG_NAME)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
objs:	$(OBJ) $(XcLIBS)

# ---------------------------------------------------------------------
link:	
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(OBJ) \
		$(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; export CPPFLAGS; \
	$(MAKE)

# ---------------------------------------------------------------------
editres:
	CPPFLAGS="$(CPPFLAGS) -DEDITRES_COMPATIBLE"; \
	X11_LIBS="$(X11_LIBS) -lXmu"; export CPPFLAGS X11_LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
replace_bin: Utils/replace_bin.o
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) Utils/replace_bin.o -o $@
	@echo " done."

# ---------------------------------------------------------------------
get_realname: Utils/get_realname.o
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) Utils/get_realname.o -o $@
	@echo " done."

# ---------------------------------------------------------------------
pixmaps:
	@cd Pixmaps; $(MAKE) clean ; $(MAKE); $(MAKE) test

# ---------------------------------------------------------------------
complete:
	@$(MAKE) ad
	@$(MAKE) builtdate
	@$(MAKE) notrace
	@$(MAKE) realname

# ---------------------------------------------------------------------
sure:
	@echo --------------------- MAKING ALL PERFECT -----------------------
	@$(MAKE) zclean
	@$(MAKE) buildenv
	@$(MAKE) complete
	@echo End time: `date`

realname:	get_realname
	@Utils/echonl.sh "Strip & Copy $(PROG_NAME) to "`get_realname`" "
	@strip $(PROG_NAME)
	@cp $(PROG_NAME) `get_realname`
	@echo "done."

# ---------------------------------------------------------------------
# Profile rules

profile:
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CFLAGS LDFLAGS LIBS; \
	$(MAKE)

profile_notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; \
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CPPFLAGS CFLAGS LDFLAGS LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
# Special compilation command

Resource/Resource.o: Resource/Resource_INSTALL.h

Box_language/Box_language.o: Box_language/Box_language.c replace_bin
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."
	@Utils/echonl.sh "Merge GIF data: select_lang.gif in"
	@Utils/echonl.sh " "`basename $@`" -> "
	@./replace_bin Box_language/Box_language.o \
		Pixmaps/select_lang.gif
	@echo " done."
	@Utils/echonl.sh "Merge GIF data: select_lang2.gif in"
	@Utils/echonl.sh " "`basename $@`" -> "
	@./replace_bin Box_language/Box_language.o \
		Pixmaps/select_lang2.gif
	@echo " done."

Box_key/Box_key.o: Box_key/Box_key.c replace_bin
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."
	@Utils/echonl.sh "Merge GIF data: axene1.gif in"
	@Utils/echonl.sh " "`basename $@`" -> "
	@./replace_bin Box_key/Box_key.o Pixmaps/axene1.gif
	@echo " done."

DocIcon/DocIcon.o: DocIcon/DocIcon.c replace_bin
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."
	@Utils/echonl.sh "Merge GIF data: pattern.gif in" 
	@Utils/echonl.sh " "`basename $@`" -> "
	@./replace_bin DocIcon/DocIcon.o Pixmaps/pattern.gif
	@echo " done."

lib/Managers.a:
	cd Managers; $(MAKE)

lib/gzip.a:
	cd Gzip; $(MAKE)

lib/Ufc.a:
	cd Ufc; $(MAKE)

Pixmaps/uptodate:
	cd Pixmaps; $(MAKE)

.c.o:
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."

.y.o:
	@Utils/echonl.sh "Yacc: "$<" "
	@yacc  $<
	@echo "done."
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c y.tab.c -o $@
	@rm -f y.tab.c
	@echo "done."

# ---------------------------------------------------------------------
# Generate config files

ad:	
	@Utils/do_ad

headers:
	@if [ -x /bin/tcsh ]; then Utils/do_header; else Utils/do_header2; fi

BUILTDATE=	Main/builtdate.h
builtdate:	
	@echo Building date:  `/bin/date` ;\
	echo "#define MAKE_DATE_DATE" \"`/bin/date`\" > $(BUILTDATE) ; \
	echo "#define MAKE_DATE_YEAR" \"`/bin/date +%y`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_MONTH" \"`/bin/date +%m`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_DAY" \"`/bin/date +%d`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_TIME" \"`/bin/date +%X`\" >> $(BUILTDATE); \
	[ -n "$SYSTEM_NAME" ] && \
	echo "#define MAKE_SYSTEM" \"$(SYSTEM_NAME)\" >> $(BUILTDATE); \
	[ -n "$PACKAGE_NAME" ] && \
	echo "#define MAKE_PACKAGE" \"$(PACKAGE_NAME)\" >> $(BUILTDATE);

buildenv:
	@$(MAKE) ad
	@$(MAKE) builtdate
	@$(MAKE) headers

showenv:
	@echo ---------------- Compilation options ---------------------------------------
	@echo "CFLAGS=\"$(CFLAGS)\""
	@echo "CPPFLAGS=\"$(CPPFLAGS)\""
	@echo "LDFLAGS=\"$(LDFLAGS)\""
	@echo "MOTIF_LIBS=\"$(MOTIF_LIBS)\""
	@echo "X11_LIBS=\"$(X11_LIBS)\""
	@echo "export CFLAGS CPPFLAGS LDFLAGS MOTIF_LIBS X11_LIBS"
	@if [ "v$(SOCK_LIBS)" != "v" ]; then \
	echo "SOCK_LIBS=\"$(SOCK_LIBS)\"; export SOCK_LIB"; fi
	@echo ----------------------------------------------------------------------------

# ---------------------------------------------------------------------
# Clean rules

clean:	
	@echo "Cleaning ROOT DIRECTORY"
	@rm -f *.o *~ *.bak \#* core *.tgz $(PROG_NAME) $(REAL_PROG_NAME)* \
		get_realname replace_bin _id 

zclean: clean clean_lib clean_pixmaps
	@echo "Cleaning *.o"
	@rm -f $(OBJ) $(PROG_NAME) Utils/*.o
	@rm -f Main/builtdate.h
	@rm -f Headers/*

clean_lib:
	@echo "Cleaning LIBS"
	@cd Managers; $(MAKE) clean
	@cd Gzip; $(MAKE) clean
	@cd Ufc; $(MAKE) clean

clean_pixmaps:
	@echo "Cleaning PIXMAPS"
	@cd Pixmaps; $(MAKE) clean > /dev/null

# ---------------------------------------------------------------------
# Make depend rule

depend:	
	cp Makefile Makefile-depend
	gcc -MM -IHeaders $(SRC) >> Makefile-depend

# ---------------------------------------------------------------------
# Make Makefile

makefile:
	@Utils/mkmakefile

all_makefiles:
	@Utils/mkmakefile all

cross_makefile:
	@Utils/mkmakefile interactive

# ---------------------------------------------------------------------
# Installationd rule

install:	get_realname
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	LANGUAGE=$${LANGUAGE:-English.us}; \
	REALNAME=`get_realname`; \
	echo "Installing $(REAL_PROG_NAME) in $$PREFIX"; \
	Utils/install.sh $(REAL_PROG_NAME) $$REALNAME $$PREFIX

uninstall:
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	echo "Uninstalling $(REAL_PROG_NAME) from $$PREFIX"; \
	rm -f $$PREFIX/bin/XInstall.*; \
	echo "$(REAL_PROG_NAME) uninstalled from $$PREFIX."

# ---------------------------------------------------------------------
# Dependencies rules

MainInterface/MainInterface.o: Global/XInstall.ad.h
