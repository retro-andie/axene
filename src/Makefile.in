SHELL= /bin/sh
SUBDIRS =

CC =
CFLAGS =
# POSIX_FLAGS: POSIX.1-1997 feature-test macros.
# Set _POSIX_C_SOURCE=199506L for all platforms.
# Add platform extras after configure determines the target OS:
#   Linux glibc:   -D_BSD_SOURCE -D_SVID_SOURCE
#   AIX 4.3:       -D_ALL_SOURCE
#   HP-UX 10.x:    -D_HPUX_SOURCE
#   IRIX:          -D_SGI_SOURCE -D_XOPEN_SOURCE
#   SunOS 4.1:     -D_POSIX_SOURCE
POSIX_FLAGS =
CPPFLAGS =
LDFLAGS =
SOCK_LIBS =
MOTIF_LIBS =
X11_LIBS =
X11CONFIG =
ARFLAGS =

SYSTEM_NAME = 
PACKAGE_NAME =

PREFIX =
LANGUAGE =

all:	$(SUBDIRS)
	@echo ""; echo "Ok, everything is built now. Next, run 'make install'."

install:	$(DEPFILES)
	@PREFIX="$(PREFIX)"; LANGUAGE="$(LANGUAGE)"; export PREFIX LANGUAGE; \
	for i in $(SUBDIRS); do \
	echo ""; echo ""; echo Install all in $$i; echo ""; echo "" ; \
	cd $$i; $(MAKE) install; cd ..; done

clean:
	@for i in $(SUBDIRS); do \
	echo ""; echo ""; echo Clean all in $$i; echo ""; echo "" ; \
	cd $$i; $(MAKE) zclean; rm -f buildenv; cd ..; done

distclean: clean
	@rm -f Makefile

uninstall:
	@PREFIX="$(PREFIX)"; export PREFIX; \
	for i in $(SUBDIRS); do \
	echo ""; echo ""; echo Uninstall $$i; echo ""; echo "" ; \
	cd $$i; $(MAKE) uninstall; cd ..; done
	@echo ""
	@echo "Shared install directories (remove manually when empty):"
	@echo "  $(PREFIX)/bin $(PREFIX)/lib/locale $(PREFIX)/lib $(PREFIX)/app-defaults $(PREFIX)"

PKGSEL = 1-6

package: $(SUBDIRS)
	@./makearchives.sh $(PKGSEL)

package-all: $(SUBDIRS)
	@./makearchives.sh 1-6 10-17

# BEGIN SUBST
<<SUBST>>:	<<SUBST>>/buildenv <<SUBST>>/main
	@echo "Ok, everything is built in <<SUBST>>"

<<SUBST>>/buildenv:
	@echo ""; echo ""; echo Build env. in <<SUBST>>; echo ""; echo "" 
	@cd <<SUBST>>; SYSTEM_NAME="$(SYSTEM_NAME)"; \
	PACKAGE_NAME="$(PACKAGE_NAME)"; export SYSTEM_NAME PACKAGE_NAME; \
	$(MAKE) buildenv
	touch <<SUBST>>/buildenv

<<SUBST>>/main:
	@echo ""; echo ""; echo Compile all in <<SUBST>>; echo ""; echo "" 
	@cd <<SUBST>>; CC="$(CC)"; CFLAGS="$(CFLAGS)"; \
	CPPFLAGS="$(CPPFLAGS)"; \
	LDFLAGS="$(LDFLAGS)"; SOCK_LIBS="$(SOCK_LIBS)"; \
	MOTIF_LIBS="$(MOTIF_LIBS)"; X11_LIBS="$(X11_LIBS)"; \
	X11CONFIG='$(X11CONFIG)'; ARFLAGS="$(ARFLAGS)"; \
	export CC CFLAGS CPPFLAGS LDFLAGS; \
	export SOCK_LIBS MOTIF_LIBS X11_LIBS X11CONFIG ARFLAGS; \
	$(MAKE) notrace; \
	$(MAKE) realname

# END SUBST
# End of global Makefile
