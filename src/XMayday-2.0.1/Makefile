SRC = $(OBJ:.o=.c)

# --------------------------------------------------------------------- 
# Program libraries variable
XcLIBS=	lib/Managers.a \
	lib/HTMLW.a \
	lib/JpegImport.a \
	lib/PngImport.a

# --------------------------------------------------------------------- 
# Uptodate files
UPTODATE= Pixmaps/uptodate RC/uptodate AD/uptodate

# ---------------------------------------------------------------------
# Compilation rules

all:	showenv $(PROG_NAME)		

# ---------------------------------------------------------------------
$(PROG_NAME):	$(UPTODATE) $(OBJ) $(XcLIBS)
	@echo Linking $(REAL_PROG_NAME)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
objs:	$(OBJ) $(XcLIBS)

# ---------------------------------------------------------------------
link:
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(OBJ) \
		$(XcLIBS) $(LIBS)

# ---------------------------------------------------------------------
notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; export CPPFLAGS; \
	$(MAKE)

# ---------------------------------------------------------------------
editres:
	CPPFLAGS="$(CPPFLAGS) -DEDITRES_COMPATIBLE"; \
	X11_LIBS="$(X11_LIBS) -lXmu"; export CPPFLAGS X11_LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
DEBUG_OBJ = HTMLW/HTML.o HTMLW/HTMLlists.o HTMLW/HTMLformat.o \
 HTMLW/HTMLparse.o HTMLW/HTMLimages.o HTMLW/HTMLwidgets.o \
 HTMLW/HTML-PSformat.o HTMLW/HTMLjot.o HTMLW/HTMLtable.o \
 HTMLW/list.o 

DEBUG_LIB = lib/Managers.a lib/JpegImport.a lib/PngImport.a

debug:	$(OBJ) $(DEBUG_OBJ) $(DEBUG_LIB)
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(OBJ) $(DEBUG_OBJ) \
		$(DEBUG_LIB) $(LIBS)

# ---------------------------------------------------------------------
get_realname: Utils/get_realname.o
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) Utils/get_realname.o -o $@
	@echo "done."

# ---------------------------------------------------------------------
pixmaps:
	@cd Pixmaps; $(MAKE) clean ; $(MAKE); $(MAKE) test

# ---------------------------------------------------------------------
complete:
	$(MAKE) ad
	$(MAKE) rc
	$(MAKE) builtdate
	$(MAKE) notrace
	$(MAKE) realname

# ---------------------------------------------------------------------
sure:
	@echo --------------------- MAKING ALL PERFECT -----------------------
	@$(MAKE) zclean
	@$(MAKE) buildenv
	@$(MAKE) complete
	@echo End time: `date`

realname:	get_realname
	@Utils/echonl.sh "Strip & Copy $(PROG_NAME) to "`get_realname`" "
	@strip $(PROG_NAME)
	@cp $(PROG_NAME) `get_realname`
	@echo "done."

# ---------------------------------------------------------------------
# Profile rules

profile:
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CFLAGS LDFLAGS LIBS; \
	$(MAKE)

profile_notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; \
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CPPFLAGS CFLAGS LDFLAGS LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
# Special compilation command

lib/Managers.a:
	cd Managers; $(MAKE)

lib/HTMLW.a:
	cd HTMLW; $(MAKE)

lib/JpegImport.a:
	cd JpegImport; $(MAKE)

lib/PngImport.a:
	cd PngImport; $(MAKE)

Pixmaps/uptodate:
	cd Pixmaps; $(MAKE)

AD/uptodate:
	@Utils/do_ad

RC/uptodate:
	@Utils/do_rc

Main/check.o:	Main/check.c
	@Utils/echonl.sh "Compile: "$@" using X11CONFIG=\"$(X11CONFIG)\" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) $(X11CONFIG) -IHeaders -c $< -o $@	   
	@echo "done."

.c.o:
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@
	@echo "done."

# ---------------------------------------------------------------------
# Generate config files

ad:
	@Utils/do_ad

rc:
	@Utils/do_rc

headers:
	@if [ -x /bin/tcsh ]; then Utils/do_header; else Utils/do_header2; fi

BUILTDATE=	Main/builtdate.h
builtdate:
	@echo Building date:  `/bin/date` ;\
	echo "#define MAKE_DATE_DATE" \"`/bin/date`\" > $(BUILTDATE) ; \
	echo "#define MAKE_DATE_YEAR" \"`/bin/date +%y`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_MONTH" \"`/bin/date +%m`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_DAY" \"`/bin/date +%d`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_TIME" \"`/bin/date +%X`\" >> $(BUILTDATE) ; \
	[ -n "$SYSTEM_NAME" ] && \
	echo "#define MAKE_SYSTEM" \"$(SYSTEM_NAME)\" >> $(BUILTDATE); \
	[ -n "$PACKAGE_NAME" ] && \
	echo "#define MAKE_PACKAGE" \"$(PACKAGE_NAME)\" >> $(BUILTDATE);

buildenv:
	@$(MAKE) ad
	@$(MAKE) rc
	@$(MAKE) builtdate
	@$(MAKE) headers

showenv:
	@echo ---------------- Compilation options ---------------------------------------
	@echo "CFLAGS=\"$(CFLAGS)\""
	@echo "CPPFLAGS=\"$(CPPFLAGS)\""
	@echo "LDFLAGS=\"$(LDFLAGS)\""
	@echo "MOTIF_LIBS=\"$(MOTIF_LIBS)\""
	@echo "X11_LIBS=\"$(X11_LIBS)\""
	@echo "export CFLAGS CPPFLAGS LDFLAGS MOTIF_LIBS X11_LIBS"
	@if [ "v$(SOCK_LIBS)" != "v" ]; then \
	echo "SOCK_LIBS=\"$(SOCK_LIBS)\"; export SOCK_LIB"; fi
	@echo ----------------------------------------------------------------------------

# ---------------------------------------------------------------------
# Clean rules

clean:
	@echo "Cleaning ROOT DIRECTORY"
	@rm -f *.o *~ \#* *.bak core $(PROG_NAME) $(REAL_PROG_NAME)* \
		get_realname

zclean:	clean clean_lib clean_pixmaps clean_pixmaps clean_ad clean_rc
	@echo "Cleaning *.o"
	@rm -f $(OBJ) Utils/*.o
	@rm -f Main/builtdate.h
	@rm -f Headers/*

clean_lib:
	@echo "Cleaning LIBS"
	@cd Managers; $(MAKE) clean
	@cd HTMLW; $(MAKE) clean
	@cd JpegImport; $(MAKE) clean
	@cd PngImport; $(MAKE) clean

clean_pixmaps:
	@echo "Cleaning PIXMAPS"
	cd Pixmaps; $(MAKE) clean > /dev/null

clean_ad:
	@Utils/do_ad clean

clean_rc:
	@Utils/do_rc clean

## ---------------------------------------------------------------------
# Make depend rule

depend:	
	cp Makefile Makefile-depend
	gcc -MM -IHeaders $(SRCS) >> Makefile-depend

# ---------------------------------------------------------------------
# Make Makefile

makefile:
	@Utils/mkmakefile

all_makefiles:
	@Utils/mkmakefile all

cross_makefile:
	@Utils/mkmakefile interactive

# ---------------------------------------------------------------------
# Installationd rule

install:	get_realname
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	LANGUAGE=$${LANGUAGE:-English.us}; \
	REALNAME=`get_realname`; \
	echo "Installing $(REAL_PROG_NAME) in $$PREFIX"; \
	Utils/install.sh $(REAL_PROG_NAME) $$REALNAME $$PREFIX; \
	echo "Customize for $$LANGUAGE language."; \
	Utils/postinstall.sh $$PREFIX $$LANGUAGE

uninstall:
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	echo "Uninstalling $(REAL_PROG_NAME) from $$PREFIX"; \
	rm -f $$PREFIX/bin/XMayday.*; \
	rm -f $$PREFIX/lib/locale/XMayday.*; \
	rm -f $$PREFIX/lib/locale/xmaydayrc.*; \
	rm -f $$PREFIX/lib/xmaydayrc; \
	rm -f $$PREFIX/app-defaults/XMayday; \
	rm -f $$PREFIX/XMayday; \
	echo "$(REAL_PROG_NAME) uninstalled from $$PREFIX."

