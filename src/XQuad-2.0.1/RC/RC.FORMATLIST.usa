
\FORMATLIST{
	\FORMAT0{\NAME{Standard} \COMMA46 \TRUNCATE_ENABLE \NORMAL_TYPE
		\STANDARD}
	\FORMAT1{\NAME{Number [0d]} \MAXPREC0 \COMMA46 \NORMAL_TYPE}
	\FORMAT2{\NAME{Number [2d]} \MAXPREC2 \COMMA46 \NORMAL_TYPE}
	\FORMAT3{\NAME{Thousands [0d]} \MAXPREC0 \SPACE3 \COMMA46 \NORMAL_TYPE}
	\FORMAT4{\NAME{Thousands [2d]} \MINPREC2 \MAXPREC2 \SPACE3
		\COMMA46 \NORMAL_TYPE \THOUSANDS}
	\FORMAT5{\NAME{Thousands [0d, red neg]} \MAXPREC0 \SPACE3 \COMMA46
		\COLORNEG200 \NORMAL_TYPE}
	\FORMAT6{\NAME{Thousands [2d, red neg]} \MINPREC2 \MAXPREC2 \SPACE3
		\COMMA46 \COLORNEG200 \NORMAL_TYPE}
	\FORMAT7{\NAME{Currency [0d]} \MAXPREC0 \SPACE3 \UNIT{$ }
		\COMMA46 \UNIT_TYPE}
	\FORMAT8{\NAME{Currency [2d]} \MINPREC2 \MAXPREC2 \SPACE3 \CHARSEP44
		\UNIT{$ } \COMMA46 \UNIT_TYPE}
	\FORMAT9{\NAME{Currency [0d, red neg]} \MAXPREC0 \SPACE3 \CHARSEP44
		\UNIT{$ } \COMMA46 \COLORNEG200 \UNIT_TYPE}
	\FORMAT10{\NAME{Currency [2d, red neg]} \MINPREC2 \MAXPREC2 \SPACE3
		\CHARSEP44 \UNIT{$ } \COMMA46 \COLORNEG200 \UNIT_TYPE
		\CURRENCY}
	\FORMAT11{\NAME{Percentage [0d]} \MAXPREC0 \UNIT{ %} \UNITAFTER
		\COMMA46 \PERCENT_TYPE}
	\FORMAT12{\NAME{Percentage [2d]} \MINPREC2 \MAXPREC2 \UNIT{ %}
		\UNITAFTER \COMMA46 \PERCENT_TYPE \PERCENT}
	\FORMAT13{\NAME{Percentage [0d, red neg]} \MAXPREC0 \UNIT{ %}
		\UNITAFTER \COMMA46 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT14{\NAME{Percentage [2d, red neg]} \MINPREC2 \MAXPREC2
		\UNIT{ %} \UNITAFTER \COMMA46 \COLORNEG200 \PERCENT_TYPE}
	\FORMAT15{\NAME{Day in week [very short]} \DAY_NAME_VERY_SHORT
		\DAY_TYPE}
	\FORMAT16{\NAME{Day in week [short]} \DAY_NAME_SHORT \DAY_TYPE}
	\FORMAT17{\NAME{Day in week [long]} \DAY_NAME_LONG \DAY_TYPE}
	\FORMAT18{\NAME{Month [very short]} \MONTH_NAME_VERY_SHORT \MONTH_TYPE}
	\FORMAT19{\NAME{Month [short]} \MONTH_NAME_SHORT \MONTH_TYPE}
	\FORMAT20{\NAME{Month [long]} \MONTH_NAME_LONG \MONTH_TYPE}
	\FORMAT21{\NAME{Boolean} \BOOLEAN_TYPE}
	\FORMAT22{\NAME{Boolean [red false]} \FALSE_COLOR200 \BOOLEAN_TYPE}
	\FORMAT23{\NAME{Boolean [custom]} \TRUE_NAME{Good} \FALSE_NAME{Bad}
		\BOOLEAN_TYPE}
	\FORMAT24{\NAME{Boolean [custom, red false]} \FALSE_COLOR200
		\TRUE_NAME{Good} \FALSE_NAME{Bad} \BOOLEAN_TYPE}
	\FORMAT25{\NAME{Date [DD/MM/YY]} \DATE_SEQUENCE{\PADDING_ZERO \DAY
		\STRING{/} \MONTH \STRING{/} \YEAR_SHORT} \DATE_TYPE}
	\FORMAT26{\NAME{Date [DD mm YYYY]} \DATE_SEQUENCE{\PADDING_SPACE \DAY
		\STRING{\x20} \MONTH_NAME_LONG \STRING{\x20} \YEAR} \DATE_TYPE}
	\FORMAT27{\NAME{Date [dd mmmm YYYY]} \DATE_SEQUENCE{ \DAY_NAME_SHORT
		\STRING{\x20} \PADDING_NONE \DAY \STRING{\x20} 
		\MONTH_NAME_LONG \STRING{\x20} \YEAR_JC_REF} \DATE_TYPE}
	\FORMAT28{\NAME{Time [HH:MM:SS.sss]} \TIME_SEQUENCE{ \PADDING_ZERO
		\HOUR \STRING{:} \MINUTE \STRING{:} \SECOND \STRING{.} 
		\THOUSANDTH_OF_SECOND} \TIME_TYPE}
	\FORMAT29{\NAME{Time [HH:MM:SS [AP]M]} \TIME_SEQUENCE{ \PADDING_SPACE
		\HOUR12 \STRING{:} \PADDING_ZERO \MINUTE \STRING{:} 
		\SECOND \STRING{\x20} \HOUR_AM_PM} \TIME_TYPE}
	\FORMAT30{\NAME{Date & time [DD/MM/YYYY HH:MM:SS]}
		\DATE_AND_TIME_SEQUENCE{\PADDING_ZERO \DAY \STRING{/}
		\MONTH \STRING{/} \YEAR \STRING{\x20} \HOUR \STRING{:}
		\MINUTE \STRING{:} \SECOND} \DATE_AND_TIME_TYPE}
	\FORMAT31{\NAME{Fraction [??/??]} \FRAC_PREC2 \FRACTION_TYPE}
	\FORMAT32{\NAME{Fraction [???/???]} \FRAC_PREC3 \FRACTION_TYPE}
	\FORMAT33{\NAME{Fraction radix [??/??]} \FRAC_PREC2 \FRAC_DECIMAL
		\FRACTION_TYPE}
	\FORMAT34{\NAME{Fraction radix [???/???]} \FRAC_PREC3 \FRAC_DECIMAL
		\FRACTION_TYPE}
	\FORMAT35{\NAME{Exp: [0,00E+00]} \COMMA46 \MIN_PREC2 \MAX_PREC2 
		\EXP_DIGIT2 \EXP_MULTIPLE1 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT36{\NAME{Exp: [##0,0E+0]} \COMMA46 \MIN_PREC1 \MAX_PREC1 
		\EXP_DIGIT1 \EXP_MULTIPLE3 \EXP_SIGN \EXP_STRING{E} 
		\EXPONANTIAL_TYPE}
	\FORMAT37{\NAME{Exp: scientific} \COMMA46 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE1 \EXP_STRING{E} \EXPONANTIAL_TYPE \SCIENTIFIC}
	\FORMAT38{\NAME{Exp: engineer} \COMMA46 \MIN_PREC0 \MAX_PREC20 
		\EXP_MULTIPLE3 \EXP_STRING{E} \EXPONANTIAL_TYPE \ENGINEER}
	\FORMAT39{\NAME{Generic} \COMMA46 \TRUNCATE_ENABLE \DAY_NAME_LONG
		\MONTH_NAME_LONG \DATE_SEQUENCE{\DAY \STRING{/}
		\PADDING_ZERO \MONTH \STRING{/} \YEAR_SHORT}
		\TIME_SEQUENCE{ \HOUR \PADDING_ZERO \STRING{:} \MINUTE }
		\DATE_AND_TIME_SEQUENCE{ \DAY \STRING{/} \PADDING_ZERO \MONTH
		\STRING{/} \YEAR \STRING{\x20} \PADDING_SPACE \HOUR 
		\PADDING_ZERO \STRING{:} \MINUTE} \FRAC_PREC3 \FRAC_DECIMAL
		\GENERIC}
	}	
