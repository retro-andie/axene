OBJ= $(OBJ1) $(OBJ2)
SRC = $(OBJ:.o=.c)

SCO_OBJ = regex.o regcmp.o range.o collate.o			#+S
								#+S
# --------------------------------------------------------------------- 
# Program libraries variable
XcLIBS= lib/VectorFont.a \
	lib/VectorGraph.a \
	lib/FontEncoding.a \
	lib/T1imager.a \
	lib/JpegImport.a \
	lib/Managers.a \
	lib/Ufc.a 

# --------------------------------------------------------------------- 
# Uptodate files
UPTODATE= Pixmaps/uptodate RC/uptodate AD/uptodate

# ---------------------------------------------------------------------
# Compilation rules

all:	showenv $(PROG_NAME) $(LAUNCHER_NAME)

# ---------------------------------------------------------------------
$(PROG_NAME):	$(UPTODATE) $(OBJ) $(XcLIBS)			#-S
$(PROG_NAME):	$(UPTODATE) $(PART1) $(PART2) $(SCO_OBJ) \	#+S
		$(XcLIBS)					#+S
	$(RANLIB) $(XcLIBS)					#+FN
	@echo Linking $(REAL_PROG_NAME)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(XcLIBS) $(LIBS)		#-S
	$(CC) $(LDFLAGS) -o $@ $(PART1) $(PART2) $(SCO_OBJ) \	#+S
		$(XcLIBS) $(LIBS)				#+S

$(PART1):	$(OBJ1)						#+S
	$(AR) $(ARFLAGS) $(PART1) $(OBJ1)			#+S
								#+S
$(PART2):	$(OBJ2)						#+S
	$(AR) $(ARFLAGS) $(PART2) $(OBJ2)			#+S
								#+S
# ---------------------------------------------------------------------
objs:	$(OBJ) $(XcLIBS)

# ---------------------------------------------------------------------
link:
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(OBJ) \		#-S
		$(XcLIBS) $(LIBS)				#-S
	$(CC) $(LDFLAGS) -o $(PROG_NAME) $(PART1) $(PART2) \	#+S
		$(SCO_OBJ) $(XcLIBS) $(LIBS)			#+S

# ---------------------------------------------------------------------
notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; export CPPFLAGS; \
	$(MAKE)

# ---------------------------------------------------------------------
editres:
	CPPFLAGS="$(CPPFLAGS) -DEDITRES_COMPATIBLE"; \
	X11_LIBS="$(X11_LIBS) -lXmu"; export CPPFLAGS X11_LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
get_realname: Utils/get_realname.o
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) Utils/get_realname.o -o $@
	@echo "done."

# ---------------------------------------------------------------------
pixmaps:
	@cd Pixmaps; $(MAKE) clean ; $(MAKE); $(MAKE) test	#-SU
	@cd Pixmaps; $(MAKE) -f Makefile.sco clean		#+S
	@cd Pixmaps; $(MAKE) -f Makefile.sco			#+S
	@cd Pixmaps; $(MAKE) -f Makefile.sco test		#+S
	@cd Pixmaps; $(MAKE) -f Makefile.unixware clean	#+U
	@cd Pixmaps; $(MAKE) -f Makefile.unixware		#+U
	@cd Pixmaps; $(MAKE) -f Makefile.unixware test	#+U

# ---------------------------------------------------------------------
complete:
	@$(MAKE) ad
	@$(MAKE) rc
	@$(MAKE) builtdate
	@$(MAKE) notrace
	@$(MAKE) realname

# ---------------------------------------------------------------------
sure:
	@echo --------------------- MAKING ALL PERFECT -----------------------
	@$(MAKE) zclean
	@$(MAKE) buildenv
	@$(MAKE) complete
	@echo End time: `date`

realname:	get_realname
	@Utils/echonl.sh "Strip & Copy $(PROG_NAME) to "`./get_realname`" "
	@strip $(PROG_NAME)
	@cp $(PROG_NAME) `./get_realname beta`
	@echo "done."
	@launcher=$(REAL_LAUNCHER_NAME)"-"`./get_realname | cut -d"-" -f2-`; \
	Utils/echonl.sh "Strip & Copy $(LAUNCHER_NAME) to $$launcher "; \
	strip $(LAUNCHER_NAME) ; cp $(LAUNCHER_NAME) $$launcher
	@echo "done."

# ---------------------------------------------------------------------
# Profile rules

profile:
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CFLAGS LDFLAGS LIBS; \
	$(MAKE)

profile_notrace:
	CPPFLAGS="$(CPPFLAGS) -DEFINITIVE_VERSION"; \
	CFLAGS="$(CFLAGS) -pg"; LDFLAGS="$(LDFLAGS) -static -pg"; \
	LIBS="$(LIBS) -lgmon"; export CPPFLAGS CFLAGS LDFLAGS LIBS; \
	$(MAKE)

# ---------------------------------------------------------------------
# Special compilation command

lib/FontEncoding.a:
	cd FontEncoding; $(MAKE)

lib/VectorGraph.a: VectorGraph/commands.c VectorGraph/dispatch.c \
	VectorGraph/VectorGraph.c VectorGraph/VectorGraph.h \
	VectorGraph/docfile.c VectorGraph/path.c VectorGraph/print.c \
	VectorGraph/redraw.c VectorGraph/load.c \
	 VectorGraph/Move_Vector.c
	cd VectorGraph; $(MAKE)				#-S
	cd VectorGraph; $(MAKE) -f Makefile.sco		#+S

lib/VectorFont.a:	
	cd VectorFont; $(MAKE)

lib/T1imager.a:
	cd T1imager; $(MAKE)						#-V
	cd T1imager; $(MAKE) "CC=cc" "CFLAGS=-DEFINITIVE_VERSION"	#+V

lib/JpegImport.a:
	cd JpegImport; $(MAKE)

lib/Managers.a:
	cd Managers; $(MAKE)

lib/Ufc.a:
	cd Ufc; $(MAKE)

Pixmaps/uptodate:
	cd Pixmaps; $(MAKE)					#-SU
	cd Pixmaps; $(MAKE) -f Makefile.sco			#+S
	cd Pixmaps; $(MAKE) -f Makefile.unixware		#+U

AD/uptodate:
	@Utils/do_ad

RC/uptodate:
	@Utils/do_rc

regex.o:							#+S
	ar x /lib/libintl.a $@					#+S
								#+S	
regcmp.o:							#+S
	ar x /lib/libintl.a $@					#+S
								#+S
range.o:							#+S
	ar x /lib/libintl.a $@					#+S
								#+S
collate.o:							#+S
	ar x /lib/libintl.a $@					#+S
								#+S
Main/check.o:	Main/check.c
	@Utils/echonl.sh "Compile: "$@" using X11CONFIG='$(X11CONFIG)' "
	@$(CC) $(CPPFLAGS) $(CFLAGS) $(X11CONFIG) -IHeaders -c $< -o $@	   #-SU
	@$(CC) $(CPPFLAGS) $(CFLAGS) $(X11CONFIG) -IHeaders -Fo$@ -c $<	   #+S
	@$(CC) $(CPPFLAGS) $(CFLAGS) $(X11CONFIG) -IHeaders -c $<	   #+U
	@echo "done."

.c.o:
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $< -o $@	#-SU
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -Fo$@ -c $<	#+S
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c $<		#+U
	@mv `basename $@` $@					#+U
	@echo "done."

.y.o:
	@Utils/echonl.sh "Yacc: "$<" "
	@yacc  $<
	@echo "done."
	@Utils/echonl.sh "Compile: "$@" "
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c y.tab.c -o $@	#-SU
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -Fo$@ -c y.tab.c	#+S
	@$(CC) $(CPPFLAGS) $(CFLAGS) -IHeaders -c y.tab.c		#+U
	@mv y.tab.o $@							#+U
	@rm -f y.tab.c
	@echo "done."

# ---------------------------------------------------------------------
# Makekey rules

MKOBJ= Makekey/Makekey.o Makekey/getdate.o Encrypt/Encrypt.o \
 Global/misc.o

MKLIBS= lib/Managers.a lib/Ufc.a

makekey: $(MKOBJ) $(MKLIBS)
	@echo "LINKING "$@" Objects: "$(MKOBJ)
	@$(CC) $(LDFLAGS) -o $@ $(MKOBJ) $(MKLIBS) $(SOCK_LIBS) -lm

genkey:	makekey
	Makekey/genkey

# ---------------------------------------------------------------------
LAOBJ = Main/launcher.o lib/Managers.a

$(LAUNCHER_NAME):	$(LAOBJ)
	@Utils/echonl.sh "Link: "$@" "
	@$(CC) $(LDFLAGS) $(LAOBJ) -o $@
	@echo "done."

# ---------------------------------------------------------------------
# Generate config files

ad:
	@Utils/do_ad

rc:
	@Utils/do_rc

headers:
	@if [ -x /bin/tcsh ]; then Utils/do_header; else Utils/do_header2; fi

BUILTDATE=	Main/builtdate.h
builtdate:
	@echo Building date:  `/bin/date` ;\
	echo "#define MAKE_DATE_DATE" \"`/bin/date`\" > $(BUILTDATE) ; \
	echo "#define MAKE_DATE_YEAR" \"`/bin/date +%y`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_MONTH" \"`/bin/date +%m`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_DAY" \"`/bin/date +%d`\" >> $(BUILTDATE) ; \
	echo "#define MAKE_DATE_TIME" \"`/bin/date +%X`\" >> $(BUILTDATE) ; \
	year=`/bin/date +%y`; iyear=`expr $$year + 0 || [ 0 -eq 0 ]` ; \
	month=`/bin/date +%m`; imonth=`expr $$month + 0 || [ 0 -eq 0 ]` ; \
	echo "#define MAKE_IDATE_YEAR" $$iyear >> $(BUILTDATE) ; \
	echo "#define MAKE_IDATE_MONTH" $$imonth >> $(BUILTDATE) ; \
	echo "#define MAKE_IDATE_DAY" `/bin/date +%e` >> $(BUILTDATE) ; \
	[ -n "$SYSTEM_NAME" ] && \
	echo "#define MAKE_SYSTEM" \"$(SYSTEM_NAME)\" >> $(BUILTDATE); \
	[ -n "$PACKAGE_NAME" ] && \
	echo "#define MAKE_PACKAGE" \"$(PACKAGE_NAME)\" >> $(BUILTDATE);

buildenv:
	@$(MAKE) ad
	@$(MAKE) rc
	@$(MAKE) builtdate
	@$(MAKE) headers

check:
	nm $(OBJ) > /dev/null

showenv:
	@echo ---------------- Compilation options ---------------------------------------
	@echo "CFLAGS=\"$(CFLAGS)\""
	@echo "CPPFLAGS=\"$(CPPFLAGS)\""
	@echo "LDFLAGS=\"$(LDFLAGS)\""
	@echo "MOTIF_LIBS=\"$(MOTIF_LIBS)\""
	@echo "X11_LIBS=\"$(X11_LIBS)\""
	@echo "export CFLAGS CPPFLAGS LDFLAGS MOTIF_LIBS X11_LIBS"
	@if [ "v$(SOCK_LIBS)" != "v" ]; then \
	echo "SOCK_LIBS=\"$(SOCK_LIBS)\"; export SOCK_LIB"; fi
	@echo ----------------------------------------------------------------------------

# ---------------------------------------------------------------------
# Clean rules

clean:
	@echo "Cleaning ROOT DIRECTORY"
	@rm -f *.o *~ \#* *.bak core $(PROG_NAME) $(REAL_PROG_NAME)* \
		$(LAUNCHER_NAME) $(REAL_LAUNCHER_NAME)* get_realname makekey
	@rm -f $(PART1) $(PART2) $(SCO_OBJ)			#+S

zclean: clean clean_lib clean_pixmaps clean_ad clean_rc
	@rm -f $(MKOBJ) $(LAOBJ) Utils/*.o
	@rm -f $(OBJ1)
	@rm -f $(OBJ2)
	@rm -f Main/builtdate.h
	@rm -f Headers/*

clean_lib:
	@cd VectorFont; $(MAKE) clean
	@cd VectorGraph; $(MAKE) clean
	@cd FontEncoding; $(MAKE) clean
	@cd T1imager; $(MAKE) clean
	@cd JpegImport; $(MAKE) clean
	@cd Managers; $(MAKE) clean
	@cd Ufc; $(MAKE) clean

clean_pixmaps:
	@echo "Cleaning PIXMAPS"
	@cd Pixmaps; $(MAKE) clean > /dev/null

clean_ad:
	@Utils/do_ad clean

clean_rc:
	@Utils/do_rc clean

# ---------------------------------------------------------------------
# Make depend rule

depend:
	cp Makefile Makefile-depend
	gcc -MM -IHeaders $(SRC) >> Makefile-depend

# ---------------------------------------------------------------------
# Make Makefile

makefile:
	@Utils/mkmakefile

all_makefiles:
	@Utils/mkmakefile all

cross_makefile:
	@Utils/mkmakefile interactive

# ---------------------------------------------------------------------
# Installationd rule

install:	get_realname
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	LANGUAGE=$${LANGUAGE:-English.us}; \
	REALNAME=`./get_realname beta`; \
	echo "Installing $(REAL_PROG_NAME) in $$PREFIX"; \
	Utils/install.sh $(REAL_PROG_NAME) $$REALNAME $$PREFIX; \
	echo "Customize for $$LANGUAGE language."; \
	Utils/postinstall.sh $$PREFIX $$LANGUAGE

uninstall:
	@PREFIX=$${PREFIX:-"/usr/local/Axene"}; \
	echo "Uninstalling $(REAL_PROG_NAME) from $$PREFIX"; \
	rm -f $$PREFIX/bin/XAllWrite.*; \
	rm -f $$PREFIX/bin/AxeneLauncher-v*; \
	rm -f $$PREFIX/lib/locale/XAllWrite.*; \
	rm -f $$PREFIX/lib/locale/xallwriterc.*; \
	rm -f $$PREFIX/lib/xcalibur.prc; \
	rm -f $$PREFIX/lib/xallwriterc; \
	rm -f $$PREFIX/app-defaults/XAllWrite; \
	rm -f $$PREFIX/XAllWrite; \
	echo "$(REAL_PROG_NAME) uninstalled from $$PREFIX."

# ---------------------------------------------------------------------
# Dependencies rules

MainInterface/MainInterface.o : Headers/version.h \
 Global/XAllWrite.ad.h
Box_about/Box_about.o: Headers/version.h Headers/builtdate.h
Box_legal/Box_legal.o: Headers/version.h
Main/main.o: Headers/version.h
Resource/Resource.o: Headers/Resource_WORD.h Headers/version.h
Readkey/Readkey.o: Headers/version.h Headers/builtdate.h
Document/Document.o: Headers/version.h
Document/docfile.o: Headers/version.h
