 Main/config.o

OBJ2 = \
 MainInterface/MainInterface.o \
 MainInterface/Actions.o \
 MainInterface/Translations.o \
 ManageWidget/ManageWidget.o \
 MenuBar/MenuBar.o \
 PulldownMenu/PulldownMenu.o \
