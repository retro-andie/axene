# PLEASE DO NOT EDIT THIS FILE, it is generated by ../Utils/mkmakefile
# Edit Makefile.in then do a "make makefile"

# Rules list:
# all:			Compile main 
# link:			Just link main
# notrace:		Compile main with -DEFINITIVE_VERSION
# editres:		Compile main with -DEDITRES_COMPATIBLE
# pixmaps:		Compress xpm in zpm format
# complete:		Make all complete
# sure:			Clean sources then make complete
# realname:		Copy main to real Package name
# genkey:		Make makekey & call tcl script
# launcher:		Axene launcher (for undo purpose).
# profile:		Make main with profile information
# profile_notrace:	Make main with profile info w/out traces
# buildenv:		Run ad, rc, builtdate and headers rules
# ad:			Make AD files (Application Defaults)
# rc:			Make RC files (Ressources)
# headers:		Link all header files in Headers/
# showenv:		Show compilation Environment variables
# clean:		Clean Main/ directory
# zclean:		Clean all
# depend:		Generate dependencies
# makefile:		Generate Makefile

# --------------------------------------------------------------------- 
# Program name variable
PROG_NAME	= main
REAL_PROG_NAME	= XAllWrite
LAUNCHER_NAME		= launcher
REAL_LAUNCHER_NAME	= AxeneLauncher
SHELL		= /bin/sh

PART1 = part1.a							#+S
PART2 = part2.a							#+S
								#+S	
# ---------------------------------------------------------------------
# POSIX.1-1997 / ANSI C89 portability flags
#
# These must appear in CPPFLAGS before any system header is processed.
# The top-level Makefile (generated by configure) passes POSIX_FLAGS
# via CPPFLAGS.  To build for a specific UNIX platform, set POSIX_FLAGS
# on the make command line or in the environment, e.g.:
#
#   AIX 4.3    : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L -D_ALL_SOURCE"
#   HP-UX 10.x : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L -D_HPUX_SOURCE"
#   IRIX 6.x   : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L -D_SGI_SOURCE"
#   Solaris 8  : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L"
#   SunOS 4.1  : POSIX_FLAGS="-D_POSIX_SOURCE"
#   FreeBSD 4  : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L"
#   NetBSD 1.5 : POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L"
#   OpenBSD 2.8: POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L"
#   Linux glibc: POSIX_FLAGS="-D_POSIX_C_SOURCE=199506L -D_BSD_SOURCE"
#
POSIX_FLAGS = -D_POSIX_C_SOURCE=199506L

# ---------------------------------------------------------------------
# Systems libraries variable
LIBS=	$(MOTIF_LIBS) $(X11_LIBS) $(SOCK_LIBS) -lm

# --------------------------------------------------------------------- 
# compil' objects variable
OBJ1 = \
