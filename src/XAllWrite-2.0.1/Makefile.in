 AutoScroll/AutoScroll.o \
 XaRegle/XaRegle.o \
 Pager/Pager.o \
 PageArea/PageArea.o \
 PageArea/Dispatch_To_Page.o \
 PageArea/Zoom_PageArea.o \
 PageArea/docfile.o \
 PageArea/print.o \
 Page/Page.o \
 Page/Edit_Functions.o \
 Page/Set_TextStyle.o \
 Page/Set_TextRuler.o \
 Page/KeyBoard_Handler.o \
 Page/Select_Move_Edit_Text.o \
 Page/Select_Text_By_Mouse.o \
 Page/Dispatch_To_FrMg.o \
 Page/FrMg_Callbacks.o \
 Page/Context_Menu_Page.o \
 Page/docfile.o \
 Page/print.o \
 Cadre/polygone.o \
 Cadre/Cadre.o \
 Cadre/geometry.o \
 Cadre/contour.o \
 Cadre/load.o \
 Cadre/print.o \
 FrameManager/FrameManager.o \
 FrameManager/Delete_Selected_Cadre.o \
 FrameManager/Lock_Unlock_Cadre.o \
 FrameManager/Set_New_Priority.o \
 FrameManager/Create_Cadres.o \
 FrameManager/Resize_Cadre.o \
 FrameManager/Move_Selected_Cadre.o \
 FrameManager/Copy_Selected_Cadre.o \
 FrameManager/Insert_Move_Delete_Points.o \
