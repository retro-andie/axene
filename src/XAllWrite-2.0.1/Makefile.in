 RowColumn/RowColumn.o \
 Form/Form.o \
 Grid/Grid.o \
 Icon/Icon.o \
 Frame/Frame.o \
 Scale/Scale.o \
 Label/Label.o \
 XLabel/XLabel.o \
 PushButton/PushButton.o \
 ToggleButton/ToggleButton.o \
 ScrolledText/ScrolledText.o \
 RadioBox/RadioBox.o \
 WTextField/WTextField.o \
 WTextField/UnitConvertion.o \
 WTextField/UnitLength.o \
 WTextField/UnitRatio.o \
 WTextField/UnitAngle.o \
 ScrolledWindow/ScrolledWindow.o \
 DrawingArea/DrawingArea.o \
 TimeIndicator/TimeIndicator.o \
 CustomDialog/CustomDialog.o \
 CustomDialog/AlertBox.o \
 FileSelector/FileSelector.o \
 FileSelector/CloseDocument.o \
 FileSelector/OpenDocument.o \
 FileSelector/PrintDocument.o \
 FileSelector/ImportDocument.o \
 FileSelector/ImportImage.o \
