! ************************************************************************
! **				FONTS LIST				**
! ************************************************************************

*fontList:		-*-helvetica-medium-r-*-*-14-*-*-*-*-*-iso8859-1
*XmMenuShell*fontList:	-*-helvetica-medium-r-*-*-12-*-*-*-*-*-iso8859-1

! ************************************************************************
! **				DEFAULT SETTINGS			**
! ************************************************************************

! Define help bubble type. Could be "Off", "Classic" or "Fun"
*helpBubblesMsg:	Classic
! ************************************************************************
! **				CURSORS					**
! ************************************************************************

*menuCursor:				right_ptr

! ************************************************************************
! **			TRAVERSAL & HIGHLIGHT THICKNESS			**
! ************************************************************************

*highlightThickness:			1

! ************************************************************************
! **                               ALIGNMENTS				**
! ************************************************************************

! ************************************************************************
! **				SHADOW THICKNESS			**
! ************************************************************************

*shadowThickness:				1
*XmSeparatorGadget.shadowThickness:		2
*XmRowColumn.shadowThickness:			0
*XmCascadeButtonGadget.shadowThickness:		1
*XmForm.shadowThickness:			0

! ************************************************************************
! **				MARGINS	& SPACINGS			**
! ************************************************************************

*XmPushButton.marginWidth:			2
*XmPushButton.marginHeight:			2
*XmToggleButtonGadget.marginLeft:		5
*XmToggleButtonGadget.marginRight:		5
*XmPushButtonGadget.marginLeft:			5
*XmPushButtonGadget.marginRight:		5
*rcMain.marginWidth:				3
*rcMain.marginHeight:				3
*rcMain.spacing:				2

! ************************************************************************
! **				BACKGROUND PIXMAPS  			**
! ************************************************************************

*rcMain.backgroundPixmap:		leather_dark
*title:		Axene Office Launcher

! ************************************************************************
! **				POPUP MENU ENTRIES			**
! ************************************************************************

*mOverride.labelString:		WM Activ
*mTransient.labelString:	WM Buttons
*mFlipV.labelString:		Vertikal spiegeln
*mFlipH.labelString:		Horizontal spiegeln
*mLaunch.labelString:		Execute
*mQuit.labelString:		Axene Office beenden


! ************************************************************************
! **				HELP BUBBLES				**
! ************************************************************************

*helpXclamationMsg:		Xclamation DTP software
*helpXQuadMsg:			XQuad Tabellenkalkulation
*helpXAllWriteMsg:		XAllWrite Word Processor
*helpXMaydayMsg:		XMayday Documentation Browser


! ************************************************************************
! **				ERRORS					**
! ************************************************************************

*sigErrorSEGVMsg:	Schutzverletzung (Segmentation fault)
*sigErrorPIPEMsg:	Verbindung unterbrochen (Broken pipe)
*sigErrorBUSMsg:	Specification exception (Bus error)
*sigErrorFPEMsg:	Arithmetic exception (Floating exception)
*sigErrorIOTMsg:	Interner Fehler (IOT trap)
*sigErrorEMTMsg:	EMT trap
*sigErrorXCPUMsg:	CPU-Zeitlimit überschritten (Cputime limit exceeded)
*sigErrorXFSZMsg:	Maximale Dateigröße überschritten (Filesize limit exceeded)
*sigErrorILLMsg:	Ungültige Anweisung (Illegal instruction)
*sigErrorINTMsg:	Axene Office wurde unterbrochen (Interrupt)
*sigErrorQuitingMsg:	Axene Office verlassen
*sigErrorSorryMsg:	Programmfortführung nicht möglich

*loadErrorMsg:		Ladefehler
*notBitmapErrorMsg:	Unbekanntes Bildformat

*lCaughtSignal.labelString:		Ein Fehler ist aufgetreten:
*lCaughtIOerror.labelString:		X-Server: Fataler Fehler
*lCannotContinue.labelString:		Fortführung nicht möglich


