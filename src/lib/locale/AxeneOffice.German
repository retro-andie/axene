*action_area.Yes.labelString:		Ja
*action_area.No.labelString:		Nein
*action_area.Apply.labelString:		Anwenden
*action_area.Ok.labelString:		Ok
*action_area.Open.labelString:		Öffnen...
*action_area.Retry.labelString:		Erneut versuchen
*action_area.Stop.labelString:		Stop
*action_area.Reset.labelString:		Reset
*action_area.Cancel.labelString:	Abbrechen
*action_area.Close.labelString:		Schließen
*action_area.Help.labelString:		Hilfe
*action_area.Save.labelString:		Speichern
*action_area.Continue.labelString:	Weiter
*action_area.Quit.labelString:		Beenden
*action_area.Save as.labelString:	Speichern unter...


