*XmMenuShell*background:		#a0b4a0

*hIconBar*background:			gray75
*hIconBar2*background:			#a0b4a0

! ** Colors: PUSH ARM ****************************************************

*hIconBar*armColor:                   gray75


! ** Colors: FOREGROUND **************************************************

*lAboutRelease.foreground:		white
*lAboutLicense.foreground:		white
*HTML.foreground:			black


! ** Colors: TOGGLE SELECTORS ********************************************

*XmToggleButtonGadget.selectColor:	yellow


! ** Colors: HIGHLIGHTS **************************************************

*highlightColor:			gray30


! ************************************************************************
! **				BACKGROUND PIXMAPS			**
! ************************************************************************

*BoxAbout*bboard.backgroundPixmap:		leather_light
*BoxAbout*action_area.backgroundPixmap:		leather_light
*BoxAbout*gBoxAbout.backgroundPixmap:		leather_light
*BoxAbout*lAboutRelease.backgroundPixmap:	leather_light
*BoxAbout*lAboutLicense.backgroundPixmap:	leather_light





! --------- + Emacs-like bindings...

*XmScrolledWindow*translations:         #override               \n\
                        <Btn4Down>:     xc_dispatch_event()     \n\
                        <Btn5Down>:     xc_dispatch_event()     \n

*XmScrolledWindow.XmScrollBar.translations:	#override	\n\
~Meta ~Alt Ctrl         <Btn4Down>:     PageUpOrLeft(0)         \n\
                        <Btn4Down>:     IncrementUpOrLeft(0)    \n\
~Meta ~Alt Ctrl         <Btn5Down>:     PageDownOrRight(0)      \n\
                        <Btn5Down>:     IncrementDownOrRight(0)	\n

*HTML.XmScrollBar.translations:		#override		\n\
~Meta ~Alt Ctrl         <Btn4Down>:     PageUpOrLeft(0)         \n\
                        <Btn4Down>:     IncrementUpOrLeft(0)    \n\
~Meta ~Alt Ctrl         <Btn5Down>:     PageDownOrRight(0)      \n\
                        <Btn5Down>:     IncrementDownOrRight(0)	\n

*XmTextField.translations:		#override	\n\
!<Key>KP_F1:		xc_insert_string("XMayday")\n\
!<Key>KP_F2:		xc_insert_string(".html")\n\
!<Key>KP_F3:		xc_insert_string("index.html")\n\
!<Key>KP_F4:		xc_insert_string("Axene")\n\
 ~Meta ~Alt Ctrl<Key>a:		beginning-of-line()		\n\
 ~Meta ~Alt Ctrl<Key>b:		backward-character()		\n\
 ~Meta ~Alt Ctrl<Key>d:		delete-next-character()		\n\
 ~Meta ~Alt Ctrl<Key>e:		end-of-line()			\n\
 ~Meta ~Alt Ctrl<Key>f:		forward-character()		\n\
 ~Meta ~Alt Ctrl<Key>g:		process-cancel()		\n\
 ~Meta ~Alt Ctrl<Key>h:		delete-previous-character()	\n\
 ~Meta ~Alt Ctrl<Key>k:		delete-to-end-of-line()		\n\
 ~Meta ~Alt Ctrl<Key>u:		beginning-of-line()		\
				delete-to-end-of-line()		\n\
 ~Meta ~Alt Ctrl<Key>w:		cut-clipboard()			\n\
 Meta ~Ctrl<Key>b:		backward-word()			\n\
  Alt ~Ctrl<Key>b:		backward-word()			\n\
 Meta ~Ctrl<Key>d:		delete-next-word()		\n\
  Alt ~Ctrl<Key>d:		delete-next-word()		\n\
 Meta ~Ctrl<Key>f:		forward-word()			\n\
  Alt ~Ctrl<Key>f:		forward-word()			\n\
 Meta ~Ctrl<Key>w:		copy-clipboard()		\n\
  Alt ~Ctrl<Key>w:		copy-clipboard()		\n\
 Meta ~Ctrl<Key>osfLeft:	backward-word()			\n\
  Alt ~Ctrl<Key>osfLeft:	backward-word()			\n\
 Meta ~Ctrl<Key>osfRight:	forward-word()			\n\
  Alt ~Ctrl<Key>osfRight:	forward-word()			\n\
 Meta ~Ctrl<Key>osfBackSpace:	delete-previous-word()		\n\
  Alt ~Ctrl<Key>osfBackSpace:	delete-previous-word()		\n\
 Meta ~Ctrl<Key>osfDelete:	delete-next-word()		\n\
  Alt ~Ctrl<Key>osfDelete:	delete-next-word()		\n
