! ************************************************************************
! **				FONTS LIST				**
! ************************************************************************

*fontList:		-*-helvetica-medium-r-*-*-14-*-*-*-*-*-iso8859-1
*XmMenuShell*fontList:	-*-helvetica-medium-r-*-*-12-*-*-*-*-*-iso8859-1

! ************************************************************************
! **				DEFAULT SETTINGS			**
! ************************************************************************

! Define help bubble type. Could be "Off", "Classic" or "Fun"
*helpBubblesMsg:	Classic
! ************************************************************************
! **				CURSORS					**
! ************************************************************************

*menuCursor:				right_ptr

! ************************************************************************
! **			TRAVERSAL & HIGHLIGHT THICKNESS			**
! ************************************************************************

*highlightThickness:			1

! ************************************************************************
! **                               ALIGNMENTS				**
! ************************************************************************

! ************************************************************************
! **				SHADOW THICKNESS			**
! ************************************************************************

*shadowThickness:				1
*XmSeparatorGadget.shadowThickness:		2
*XmRowColumn.shadowThickness:			0
*XmCascadeButtonGadget.shadowThickness:		1
*XmForm.shadowThickness:			0

! ************************************************************************
! **				MARGINS	& SPACINGS			**
! ************************************************************************

*XmPushButton.marginWidth:			2
*XmPushButton.marginHeight:			2
*XmToggleButtonGadget.marginLeft:		5
*XmToggleButtonGadget.marginRight:		5
*XmPushButtonGadget.marginLeft:			5
*XmPushButtonGadget.marginRight:		5
*rcMain.marginWidth:				3
*rcMain.marginHeight:				3
*rcMain.spacing:				2

! ************************************************************************
! **				BACKGROUND PIXMAPS  			**
! ************************************************************************

*rcMain.backgroundPixmap:		leather_dark
*title:		Axene Office Launcher

! ************************************************************************
! **				POPUP MENU ENTRIES			**
! ************************************************************************

*mOverride.labelString:		WM Activ
*mTransient.labelString:	WM Buttons
*mFlipV.labelString:		Flip Verticaly
*mFlipH.labelString:		Flip Horizontaly
*mLaunch.labelString:		Execute
*mQuit.labelString:		Quit Axene Office


! ************************************************************************
! **				HELP BUBBLES				**
! ************************************************************************

*helpXclamationMsg:		Xclamation DTP software
*helpXQuadMsg:			XQuad Spreadsheet
*helpXAllWriteMsg:		XAllWrite Word Processor
*helpXMaydayMsg:		XMayday Documentation Browser


! ************************************************************************
! **				ERRORS					**
! ************************************************************************

*sigErrorSEGVMsg:		Segmentation violation (Segmentation fault)
*sigErrorPIPEMsg:		Connection broken (Broken pipe)
*sigErrorBUSMsg:		Specification exception (Bus error)
*sigErrorFPEMsg:		Arithmetic exception (Floating exception)
*sigErrorIOTMsg:		Internal Error (IOT trap)
*sigErrorEMTMsg:		EMT instruction (EMT trap)
*sigErrorXCPUMsg:		Cputime limit exceeded
*sigErrorXFSZMsg:		Filesize limit exceeded
*sigErrorILLMsg:		Illegal instruction
*sigErrorINTMsg:		Axene Office has been interrupted (Interrupt)
*sigErrorQuitingMsg:		Exit Axene Office now
*sigErrorSorryMsg:		Impossible to go on

*loadErrorMsg:			Loading Error
*notBitmapErrorMsg:		Unknown Image format

*lCaughtSignal.labelString:		A failure has occured:
*lCaughtIOerror.labelString:		X I/O fatal error
*lCannotContinue.labelString:		Impossible to go on


! ************************************************************************
! **			DEFAULT DIALOG BUTTONS				**
! ************************************************************************

*action_area.Yes.labelString:		Yes
*action_area.No.labelString:		No
*action_area.Apply.labelString:		Apply
*action_area.Ok.labelString:		Ok
*action_area.Open.labelString:		Open...
*action_area.Retry.labelString:		Retry
*action_area.Stop.labelString:		Stop
*action_area.Reset.labelString:		Reset
*action_area.Cancel.labelString:	Cancel
*action_area.Close.labelString:		Close
*action_area.Help.labelString:		Help
*action_area.Save.labelString:		Save
*action_area.Continue.labelString:	Continue
*action_area.Quit.labelString:		Exit
*action_area.Save as.labelString:	Save as...


! ************************************************************************
! **				WARNING DIALOG BOXES			**
! ************************************************************************

! ** Warning dialog: QUIT ************************************************
*quitMessageMsg:			Quit Axene Office












! ************************************************************************
! **				COLORS					**
! ************************************************************************

! ** Colors: BACKGROUND **************************************************

*background:				gray65
*XmPushButton.background:		#B1B0B8
*TopLevelShell*borderColor:		gray65
*Application*borderColor:		black

! ** Colors: HIGHLIGHTS **************************************************

*highlightColor:			black

! ************************************************************************
! **				BACKGROUND PIXMAPS			**
! ************************************************************************

*rcMain.translations:		#override				\n\
                   <Btn3Down>:		xc_popup()			\n\
	 ~Alt ~Meta Ctrl<Key>q:		xc_quit()			\n\
	         <Btn1Down>(2):		xc_override()			\n\
	         <Btn2Down>(2):		xc_transient()			\n\
		    <Btn4Down>:		ManagerGadgetTraversePrev()	\n\
		    <Btn5Down>:		ManagerGadgetTraverseNext()	\n
	
*XmPushButton.translations:	#override				\n\
		<Btn4Down>:		xc_dispatch_up()		\n\
		<Btn5Down>:		xc_dispatch_up()		\n\
		<Btn3Down>:		xc_dispatch_up()		\n\
	 ~Alt ~Meta Ctrl<Key>q:		xc_quit()			\n\
		<Key>1:			xc_launch("Xclamation")		\n\
		<Key>2:			xc_launch("XQuad")		\n\
		<Key>3:			xc_launch("XAllWrite")		\n\
		<Key>4:			xc_launch("XMayday")		\n


