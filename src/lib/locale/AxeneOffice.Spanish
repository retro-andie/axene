! ************************************************************************
! **				FONTS LIST				**
! ************************************************************************

*fontList:		-*-helvetica-medium-r-*-*-14-*-*-*-*-*-iso8859-1
*XmMenuShell*fontList:	-*-helvetica-medium-r-*-*-12-*-*-*-*-*-iso8859-1

! ************************************************************************
! **				DEFAULT SETTINGS			**
! ************************************************************************

! Define help bubble type. Could be "Off", "Classic" or "Fun"
*helpBubblesMsg:	Classic
! ************************************************************************
! **				CURSORS					**
! ************************************************************************

*menuCursor:				right_ptr

! ************************************************************************
! **			TRAVERSAL & HIGHLIGHT THICKNESS			**
! ************************************************************************

*highlightThickness:			1

! ************************************************************************
! **                               ALIGNMENTS				**
! ************************************************************************

! ************************************************************************
! **				SHADOW THICKNESS			**
! ************************************************************************

*shadowThickness:				1
*XmSeparatorGadget.shadowThickness:		2
*XmRowColumn.shadowThickness:			0
*XmCascadeButtonGadget.shadowThickness:		1
*XmForm.shadowThickness:			0

! ************************************************************************
! **				MARGINS	& SPACINGS			**
! ************************************************************************

*XmPushButton.marginWidth:			2
*XmPushButton.marginHeight:			2
*XmToggleButtonGadget.marginLeft:		5
*XmToggleButtonGadget.marginRight:		5
*XmPushButtonGadget.marginLeft:			5
*XmPushButtonGadget.marginRight:		5
*rcMain.marginWidth:				3
*rcMain.marginHeight:				3
*rcMain.spacing:				2

! ************************************************************************
! **				BACKGROUND PIXMAPS  			**
! ************************************************************************

*rcMain.backgroundPixmap:		leather_dark
*title:		Axene Office Launcher

! ************************************************************************
! **				POPUP MENU ENTRIES			**
! ************************************************************************

*mOverride.labelString:		WM Activ
*mTransient.labelString:	WM Buttons
*mFlipV.labelString:		Espejo vertical
*mFlipH.labelString:		Espejo horizontal
*mLaunch.labelString:		Abrir
*mQuit.labelString:		Salir de Axene Office


! ************************************************************************
! **				HELP BUBBLES				**
! ************************************************************************

*helpXclamationMsg:		Xclamation Autoedición
*helpXQuadMsg:			XQuad Hoja electrónica
*helpXAllWriteMsg:		XAllWrite Word Processor
*helpXMaydayMsg:		XMayday Documentación


! ************************************************************************
! **				ERRORS					**
! ************************************************************************

*sigErrorSEGVMsg:	Violación de privilegios (Segmentation fault)
*sigErrorPIPEMsg:	Conexión interrumpida (Broken pipe)
*sigErrorBUSMsg:        Error de bus (Bus error)
*sigErrorFPEMsg:        Error de cálculo (Floating exception)
*sigErrorIOTMsg:        Error interno (IOT trap)
*sigErrorEMTMsg:        Desvío Error Memoria (EMT trap)
*sigErrorXCPUMsg:       Rebasamiento de tiempo CPU (Cputime limit exceeded)
*sigErrorXFSZMsg:       Rebasamiento de tamaño de fichero (Filesize limit exceeded)
*sigErrorILLMsg:        Instrucción ilícita (Illegal instruction)
*sigErrorINTMsg:        Axene Office ha sido (Interrupt)
*sigErrorQuitingMsg:	Salir ahora de Axene Office
*sigErrorSorryMsg:	Imposible seguir ejecutando

*loadErrorMsg:          Error de cargamento
*notBitmapErrorMsg:     Formato de imagen no reconocido

*lCaughtSignal.labelString:		Un error se ha producido :
*lCaughtIOerror.labelString:            Error fatal del servidor X
*lCannotContinue.labelString:           Imposible proseguir


! ************************************************************************
! **			DEFAULT DIALOG BUTTONS				**
! ************************************************************************

*action_area.Yes.labelString:		Sí
*action_area.No.labelString:		No
*action_area.Apply.labelString:		Aplicar
*action_area.Ok.labelString:		De acuerdo
*action_area.Open.labelString:		Abrir...
*action_area.Retry.labelString:		Repetir
*action_area.Stop.labelString:		Parar
*action_area.Reset.labelString:		Reinicializar
*action_area.Cancel.labelString:	Cancelar
*action_area.Close.labelString:		Cerrar
*action_area.Help.labelString:		Ayuda
*action_area.Save.labelString:		Salvaguardar
*action_area.Continue.labelString:	Proseguir
*action_area.Quit.labelString:		Salir
*action_area.Save as.labelString:	Salvaguardar bajo...


! ************************************************************************
! **				WARNING DIALOG BOXES			**
! ************************************************************************

! ** Warning dialog: QUIT ************************************************
*quitMessageMsg:			Salir de Axene Office

! ************************************************************************
! **				COLORS					**
! ************************************************************************

! ** Colors: BACKGROUND **************************************************

*background:				gray65
*XmPushButton.background:		#B1B0B8
*TopLevelShell*borderColor:		gray65
*Application*borderColor:		black

! ** Colors: HIGHLIGHTS **************************************************

*highlightColor:			black

! ************************************************************************
! **				BACKGROUND PIXMAPS			**
! ************************************************************************

*rcMain.translations:		#override				\n\
                   <Btn3Down>:		xc_popup()			\n\
	 ~Alt ~Meta Ctrl<Key>q:		xc_quit()			\n\
	         <Btn1Down>(2):		xc_override()			\n\
	         <Btn2Down>(2):		xc_transient()			\n\
		    <Btn4Down>:		ManagerGadgetTraversePrev()	\n\
		    <Btn5Down>:		ManagerGadgetTraverseNext()	\n
	
*XmPushButton.translations:	#override				\n\
		<Btn4Down>:		xc_dispatch_up()		\n\
		<Btn5Down>:		xc_dispatch_up()		\n\
		<Btn3Down>:		xc_dispatch_up()		\n\
	 ~Alt ~Meta Ctrl<Key>q:		xc_quit()			\n\
		<Key>1:			xc_launch("Xclamation")		\n\
		<Key>2:			xc_launch("XQuad")		\n\
		<Key>3:			xc_launch("XAllWrite")		\n\
		<Key>4:			xc_launch("XMayday")		\n


