\STYLELIST{
	\STYLE0{\FONT{Helvetica}
		\COLOR1 12 \NAME{Normal}
	}
	\STYLE1{\FONT{AvantGarde-DemiOblique}
		\COLOR1 30 \NAME{Title}
		\WIDTH{0.8}
		\UNDERLINE{0.2 0 0.1 \COLOR11 0 False}
		\SMALLCAPS
	}
	\STYLE2{\FONT{Helvetica-Bold}
		\COLOR1 16 \NAME{Section}
	}
	\STYLE3{\FONT{NewCenturySchlbk-BoldItalic}
		\COLOR120 24 \NAME{Shadow Title}
		\SHADOW{0.1 0.1 \COLOR190}
		\SMALLCAPS
	}
	\STYLE4{\FONT{Times-Italic}
		\COLOR43 14 \NAME{Quotation}
		\UNDERLINE{0.2 0 0.05 \COLOR150 0 False}
	}
	\STYLE5{\FONT{Helvetica}
		\COLOR1 12 \NAME{Normal Superscript}
		\UNDERLINE{0.2 0 0.1 \COLOR1 0 False}
		\SUPERSCRIPT{0.4 0.6}
	}
	\STYLE6{\FONT{ZapfDingbats}
		\COLOR53 16 \NAME{Dingbats}
	}
	\STYLE7{\FONT{AvantGarde-Book}
		\COLOR13 40 \NAME{Special}
		\WIDTH{3}
		\STRIKEOUT{-0.25 0.3 0.2 \COLOR2 0 False}
		\SMALLCAPS
	}
}

