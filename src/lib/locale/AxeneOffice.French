*action_area.Yes.labelString:		Oui
*action_area.No.labelString:		Non
*action_area.Apply.labelString:		Appliquer
*action_area.Ok.labelString:		Ok
*action_area.Open.labelString:		Ouvrir...
*action_area.Retry.labelString:		Recommencer
*action_area.Stop.labelString:		Arrêter
*action_area.Reset.labelString:		Réinitialiser
*action_area.Cancel.labelString:	Annuler
*action_area.Close.labelString:		Fermer
*action_area.Help.labelString:		Aide
*action_area.Save.labelString:		Sauver
*action_area.Continue.labelString:	Continuer
*action_area.Quit.labelString:		Quitter
*action_area.Save as.labelString:	Sauver sous...


