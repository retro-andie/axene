if ($# == 1) then
 set t = `find . -mtime -$argv[1] -print | fgrep -v ".o" | fgrep -v "~" | fgrep -v ".a" | fgrep -v ".zpm" | fgrep -v "core" | fgrep -v "change_code" | fgrep -v "Headers/"`
 set fi = ""
 foreach name ($t)
  if (! -d $name) then
   if (! -x $name) then
    echo $name
    set fi = `echo $fi $name`
   else
    set siz = ""
    set inc = 1
    while ($siz == "")
     set siz = `wc -c $name | cut -d" "  -f$inc`
     set inc = `expr $inc + 1`
    end
    if ( `expr $siz` < 10000 ) then
     set fi = `echo $fi $name`
    endif
   endif
  endif
 end
else
 echo "Usage viewNew number(day) "
endif

